impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**Get the `WorldSettings` from the singleton `world_settings` table, or its default while no row exists.

The default is not written to the table.*/
    pub fn get_world_settings<'a>(
        &'a self,
    ) -> Result<WorldSettings, crate::spacetimedsl::error::SpacetimeDSLError> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().world_settings().id().find(&0u8) {
            Some(world_settings) => Ok(world_settings),
            None => {
                let mut world_settings = <WorldSettings as crate::spacetimedsl::DefaultSingleton>::get_default(
                    &crate::spacetimedsl::read_only_dsl(self.ctx()),
                )?;
                world_settings.id = 0u8;
                Ok(world_settings)
            }
        }
    }
}
