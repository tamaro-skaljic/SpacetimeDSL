impl WorldSettings {
    ///
    pub fn get_maximum_player_count(&self) -> &u32 {
        use spacetimedsl::Wrapper;
        &self.maximum_player_count
    }
    ///
    pub fn get_maximum_player_count_mut(&mut self) -> &mut u32 {
        use spacetimedsl::Wrapper;
        &mut self.maximum_player_count
    }
    ///
    pub fn set_maximum_player_count(&mut self, maximum_player_count: u32) -> u32 {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.maximum_player_count,
            maximum_player_count,
        );
        old_value
    }
    ///
    pub fn get_world_name(&self) -> &String {
        use spacetimedsl::Wrapper;
        &self.world_name
    }
    ///
    pub fn get_world_name_mut(&mut self) -> &mut String {
        use spacetimedsl::Wrapper;
        &mut self.world_name
    }
    ///
    pub fn set_world_name(&mut self, world_name: String) -> String {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.world_name, world_name);
        old_value
    }
    ///
    pub fn get_created_at(&self) -> &Option<Timestamp> {
        use spacetimedsl::Wrapper;
        &self.created_at
    }
    ///
    pub fn get_modified_at(&self) -> &Option<Timestamp> {
        use spacetimedsl::Wrapper;
        &self.modified_at
    }
}
