/// The type through which the tables on the other side of this table's foreign keys
/// reach it.
#[doc(hidden)]
pub struct FeatureFlagsTable;
impl FeatureFlags {
    ///
    pub fn get_tutorial_is_enabled(&self) -> &bool {
        use crate::spacetimedsl::Wrapper;
        &self.tutorial_is_enabled
    }
    ///
    pub fn get_tutorial_is_enabled_mut(&mut self) -> &mut bool {
        use crate::spacetimedsl::Wrapper;
        &mut self.tutorial_is_enabled
    }
    ///
    pub fn set_tutorial_is_enabled(&mut self, tutorial_is_enabled: bool) -> bool {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.tutorial_is_enabled,
            tutorial_is_enabled,
        );
        old_value
    }
}

