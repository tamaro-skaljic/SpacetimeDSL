impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to get a `Stage` from the `stage` table whose value matches the value from the unique single-column btree index on the `next_stage_id` column.*/
    pub fn get_stage_by_next_stage_id<'a>(
        &'a self,
        next_stage_id: impl Into<StageId> + Clone,
    ) -> Result<Stage, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self
            .db()
            .stage()
            .next_stage_id()
            .find(next_stage_id.clone().into().value())
        {
            Some(stage) => Ok(stage),
            None => {
                return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                    table_name: "stage".into(),
                    column_names_and_row_values: format!(
                        "{{ next_stage_id : {} }}", next_stage_id.clone().into().value()
                    )
                        .into(),
                });
            }
        }
    }
}
