    /**References the `id` column of the `player` table (`self`).

- On delete: none, the `player` table is not deletable
- On soft delete: none, the `player` table is not soft-deletable*/
    pub fn set_player_id(&mut self, player_id: impl Into<PlayerId>) -> PlayerId {
