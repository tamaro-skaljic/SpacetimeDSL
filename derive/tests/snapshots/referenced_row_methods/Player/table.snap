#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct PlayerId {
    value: u64,
}
impl Default for PlayerId {
    fn default() -> PlayerId {
        PlayerId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for PlayerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "PlayerId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for PlayerId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Player> for PlayerId {
    fn from(value: &Player) -> Self {
        PlayerId {
            value: value.id.clone(),
        }
    }
}
impl From<&Player> for Option<PlayerId> {
    fn from(value: &Player) -> Option<PlayerId> {
        Some(PlayerId {
            value: value.id.clone(),
        })
    }
}
impl From<&PlayerId> for Option<PlayerId> {
    fn from(value: &PlayerId) -> Option<PlayerId> {
        use crate::spacetimedsl::Wrapper;
        Some(PlayerId::new(value.value()))
    }
}
impl From<&PlayerId> for PlayerId {
    fn from(value: &PlayerId) -> Self {
        use crate::spacetimedsl::Wrapper;
        PlayerId::new(value.value())
    }
}
impl Player {
    ///
    pub fn get_id(&self) -> PlayerId {
        use crate::spacetimedsl::Wrapper;
        PlayerId::new(self.id.clone())
    }
}

