#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct BannerId {
    value: u64,
}
impl Default for BannerId {
    fn default() -> BannerId {
        BannerId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for BannerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "BannerId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for BannerId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Banner> for BannerId {
    fn from(value: &Banner) -> Self {
        BannerId {
            value: value.id.clone(),
        }
    }
}
impl From<&Banner> for Option<BannerId> {
    fn from(value: &Banner) -> Option<BannerId> {
        Some(BannerId {
            value: value.id.clone(),
        })
    }
}
impl From<&BannerId> for Option<BannerId> {
    fn from(value: &BannerId) -> Option<BannerId> {
        use crate::spacetimedsl::Wrapper;
        Some(BannerId::new(value.value()))
    }
}
impl From<&BannerId> for BannerId {
    fn from(value: &BannerId) -> Self {
        use crate::spacetimedsl::Wrapper;
        BannerId::new(value.value())
    }
}
impl Banner {
    ///
    pub fn get_id(&self) -> BannerId {
        use crate::spacetimedsl::Wrapper;
        BannerId::new(self.id.clone())
    }
    /**References the `id` column of the `server` table (`self`).

- On delete: none, the `server` table is not deletable
- On soft delete: none, the `server` table is not soft-deletable*/
    pub fn get_server_id(&self) -> ServerId {
