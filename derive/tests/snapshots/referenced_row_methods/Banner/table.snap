#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct BannerId {
    value: u64,
}
impl Default for BannerId {
    fn default() -> BannerId {
        BannerId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for BannerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "BannerId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for BannerId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Banner> for BannerId {
    fn from(value: &Banner) -> Self {
        BannerId {
            value: value.id.clone(),
        }
    }
}
impl From<&Banner> for Option<BannerId> {
    fn from(value: &Banner) -> Option<BannerId> {
