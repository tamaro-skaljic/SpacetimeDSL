// ServerTable
impl crate::spacetimedsl::internal::References<self::ServerTable, u64>
for AllianceTable {}

// get_by_primary_key
impl AllianceTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `alliance` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        id: impl Into<AllianceId> + Clone,
    ) -> Result<Alliance, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_alliance_by_id(id)
    }
}
