#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct AllianceId {
    value: u64,
}
impl Default for AllianceId {
    fn default() -> AllianceId {
        AllianceId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for AllianceId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "AllianceId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for AllianceId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Alliance> for AllianceId {
    fn from(value: &Alliance) -> Self {
        AllianceId {
            value: value.id.clone(),
        }
    }
}
impl From<&Alliance> for Option<AllianceId> {
    fn from(value: &Alliance) -> Option<AllianceId> {
        Some(AllianceId {
            value: value.id.clone(),
        })
    }
}
impl From<&AllianceId> for Option<AllianceId> {
    fn from(value: &AllianceId) -> Option<AllianceId> {
        use crate::spacetimedsl::Wrapper;
        Some(AllianceId::new(value.value()))
