#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct ServerId {
    value: u64,
}
impl Default for ServerId {
    fn default() -> ServerId {
        ServerId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ServerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ServerId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for ServerId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Server> for ServerId {
    fn from(value: &Server) -> Self {
        ServerId {
            value: value.id.clone(),
        }
    }
}
impl From<&Server> for Option<ServerId> {
    fn from(value: &Server) -> Option<ServerId> {
        Some(ServerId {
            value: value.id.clone(),
        })
    }
}
impl From<&ServerId> for Option<ServerId> {
    fn from(value: &ServerId) -> Option<ServerId> {
        use crate::spacetimedsl::Wrapper;
        Some(ServerId::new(value.value()))
    }
}
impl From<&ServerId> for ServerId {
    fn from(value: &ServerId) -> Self {
        use crate::spacetimedsl::Wrapper;
        ServerId::new(value.value())
    }
}
impl Server {
    ///
    pub fn get_id(&self) -> ServerId {
        use crate::spacetimedsl::Wrapper;
        ServerId::new(self.id.clone())
    }
    /**References the `id` column of the `season` table (`self`).

- On delete: none, the `season` table is not deletable
- On soft delete: none, the `season` table is not soft-deletable*/
    pub fn get_season_id(&self) -> SeasonId {
        use crate::spacetimedsl::Wrapper;
        SeasonId::new(self.season_id.clone())
    }
}
