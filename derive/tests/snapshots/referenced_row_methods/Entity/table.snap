#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct EntityId {
    value: u64,
}
impl Default for EntityId {
    fn default() -> EntityId {
        EntityId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for EntityId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "EntityId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for EntityId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Entity> for EntityId {
    fn from(value: &Entity) -> Self {
        EntityId {
            value: value.id.clone(),
        }
    }
}
impl From<&Entity> for Option<EntityId> {
    fn from(value: &Entity) -> Option<EntityId> {
        Some(EntityId {
            value: value.id.clone(),
        })
    }
}
impl From<&EntityId> for Option<EntityId> {
    fn from(value: &EntityId) -> Option<EntityId> {
        use crate::spacetimedsl::Wrapper;
        Some(EntityId::new(value.value()))
    }
}
impl From<&EntityId> for EntityId {
    fn from(value: &EntityId) -> Self {
        use crate::spacetimedsl::Wrapper;
        EntityId::new(value.value())
    }
}
impl Entity {
    ///
    pub fn get_id(&self) -> EntityId {
        use crate::spacetimedsl::Wrapper;
        EntityId::new(self.id.clone())
    }
}

