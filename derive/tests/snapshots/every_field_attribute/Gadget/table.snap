#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct GadgetId {
    value: u64,
}
impl Default for GadgetId {
    fn default() -> GadgetId {
        GadgetId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for GadgetId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "GadgetId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for GadgetId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Gadget> for GadgetId {
    fn from(value: &Gadget) -> Self {
        GadgetId {
            value: value.id.clone(),
        }
    }
}
impl From<&Gadget> for Option<GadgetId> {
    fn from(value: &Gadget) -> Option<GadgetId> {
        Some(GadgetId {
            value: value.id.clone(),
        })
    }
}
impl From<&GadgetId> for Option<GadgetId> {
    fn from(value: &GadgetId) -> Option<GadgetId> {
        use crate::spacetimedsl::Wrapper;
        Some(GadgetId::new(value.value()))
