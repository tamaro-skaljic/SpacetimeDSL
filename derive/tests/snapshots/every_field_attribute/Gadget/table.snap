        OwnerId::new(self.owner_id.clone())
    }
    ///
    pub fn set_owner_id(&mut self, owner_id: impl Into<OwnerId>) -> OwnerId {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.owner_id, owner_id.into().value());
        OwnerId::new(old_value)
    }
    ///
