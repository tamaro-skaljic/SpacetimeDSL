impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Get a `Transfer` iterator that contains all rows in the `transfer` table whose value matches the value from the single-column btree index on the `source_ledger_id` column.
    pub fn get_transfers_by_source_ledger_id<'a>(
        &'a self,
        source_ledger_id: impl Into<::other_crate::tables::LedgerId>,
    ) -> impl Iterator<Item = Transfer> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        self.db().transfer().source_ledger_id().filter(source_ledger_id.into().value())
    }
}
impl<T: crate::spacetimedsl::ReadContext> crate::spacetimedsl::ReadOnlyDSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Get a `Transfer` iterator that contains all rows in the `transfer` table whose value matches the value from the single-column btree index on the `source_ledger_id` column.
    pub fn get_transfers_by_source_ledger_id<'a>(
        &'a self,
        source_ledger_id: impl Into<::other_crate::tables::LedgerId>,
    ) -> impl Iterator<Item = Transfer> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        self.db().transfer().source_ledger_id().filter(source_ledger_id.into().value())
    }
}
