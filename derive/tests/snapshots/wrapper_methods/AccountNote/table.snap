#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct AccountNoteId {
    value: u64,
}
impl Default for AccountNoteId {
    fn default() -> AccountNoteId {
        AccountNoteId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for AccountNoteId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "AccountNoteId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, AccountNoteId> for AccountNoteId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&AccountNote> for AccountNoteId {
    fn from(value: &AccountNote) -> Self {
        AccountNoteId {
            value: value.id.clone(),
        }
    }
}
impl From<&AccountNote> for Option<AccountNoteId> {
    fn from(value: &AccountNote) -> Option<AccountNoteId> {
        Some(AccountNoteId {
            value: value.id.clone(),
        })
    }
}
impl From<&AccountNoteId> for Option<AccountNoteId> {
    fn from(value: &AccountNoteId) -> Option<AccountNoteId> {
        use spacetimedsl::Wrapper;
        Some(AccountNoteId::new(value.value()))
    }
}
impl From<&AccountNoteId> for AccountNoteId {
    fn from(value: &AccountNoteId) -> Self {
        use spacetimedsl::Wrapper;
        AccountNoteId::new(value.value())
    }
}
impl AccountNote {
    ///
    pub fn get_id(&self) -> AccountNoteId {
        use spacetimedsl::Wrapper;
        AccountNoteId::new(self.id.clone())
    }
    ///
    pub fn get_account_id(&self) -> crate::accounts::AccountId {
        use spacetimedsl::Wrapper;
        crate::accounts::AccountId::new(self.account_id.clone())
    }
    ///
    pub fn set_account_id(
        &mut self,
        account_id: impl Into<crate::accounts::AccountId>,
    ) -> crate::accounts::AccountId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.account_id,
            account_id.into().value(),
        );
        crate::accounts::AccountId::new(old_value)
    }
}
