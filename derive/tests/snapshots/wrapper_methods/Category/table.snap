#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct CategoryId {
    value: u64,
}
impl Default for CategoryId {
    fn default() -> CategoryId {
        CategoryId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for CategoryId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "CategoryId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, CategoryId> for CategoryId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Category> for CategoryId {
    fn from(value: &Category) -> Self {
        CategoryId {
            value: value.id.clone(),
        }
    }
}
impl From<&Category> for Option<CategoryId> {
    fn from(value: &Category) -> Option<CategoryId> {
        Some(CategoryId {
            value: value.id.clone(),
        })
    }
}
impl From<&CategoryId> for Option<CategoryId> {
    fn from(value: &CategoryId) -> Option<CategoryId> {
        use spacetimedsl::Wrapper;
        Some(CategoryId::new(value.value()))
    }
}
impl From<&CategoryId> for CategoryId {
    fn from(value: &CategoryId) -> Self {
        use spacetimedsl::Wrapper;
        CategoryId::new(value.value())
    }
}
impl Category {
    ///
    pub fn get_id(&self) -> CategoryId {
        use spacetimedsl::Wrapper;
        CategoryId::new(self.id.clone())
    }
    ///
    pub fn get_parent_category_id(&self) -> CategoryId {
        use spacetimedsl::Wrapper;
        CategoryId::new(self.parent_category_id.clone())
    }
    ///
    pub fn set_parent_category_id(
        &mut self,
        parent_category_id: impl Into<CategoryId>,
    ) -> CategoryId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.parent_category_id,
            parent_category_id.into().value(),
        );
        CategoryId::new(old_value)
    }
}
///
pub struct CreateCategory {
    pub parent_category_id: CategoryId,
}

