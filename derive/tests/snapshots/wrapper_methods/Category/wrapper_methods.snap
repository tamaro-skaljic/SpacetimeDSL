impl CategoryId {
    /**Get all `Category` rows whose `parent_category_id` column references this `CategoryId`.

Use it like `category_id.get_categories_by_parent_category_id(&dsl)`.*/
    pub fn get_categories_by_parent_category_id<
        'a,
        T: 'a + crate::spacetimedsl::ReadContext,
    >(&self, dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>) -> Vec<Category> {
        dsl.into().get_categories_by_parent_category_id(self).collect()
    }
}
impl CategoryId {
    /**Get the row of the `category` table which the `parent_category_id` column of the `Category` row with this `CategoryId` references.

Use it like `category_id.get_parent_category(&dsl)`.*/
    pub fn get_parent_category<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::category__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let category = dsl.get_category_by_id(self)?;
        dsl.get_category_by_id(category.get_parent_category_id())
    }
}
