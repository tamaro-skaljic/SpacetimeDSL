#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct AccountId {
    value: u64,
}
impl Default for AccountId {
    fn default() -> AccountId {
        AccountId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for AccountId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "AccountId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, AccountId> for AccountId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Account> for AccountId {
    fn from(value: &Account) -> Self {
        AccountId {
            value: value.id.clone(),
        }
    }
}
impl From<&Account> for Option<AccountId> {
    fn from(value: &Account) -> Option<AccountId> {
        Some(AccountId {
            value: value.id.clone(),
        })
    }
}
impl From<&AccountId> for Option<AccountId> {
    fn from(value: &AccountId) -> Option<AccountId> {
        use spacetimedsl::Wrapper;
        Some(AccountId::new(value.value()))
    }
}
impl From<&AccountId> for AccountId {
    fn from(value: &AccountId) -> Self {
        use spacetimedsl::Wrapper;
        AccountId::new(value.value())
    }
}
impl Account {
    ///
    pub fn get_id(&self) -> AccountId {
        use spacetimedsl::Wrapper;
        AccountId::new(self.id.clone())
    }
}

