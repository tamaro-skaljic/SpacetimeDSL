#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct MembershipId {
    value: u64,
}
impl Default for MembershipId {
    fn default() -> MembershipId {
        MembershipId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for MembershipId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "MembershipId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for MembershipId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Membership> for MembershipId {
    fn from(value: &Membership) -> Self {
        MembershipId {
            value: value.id.clone(),
        }
    }
}
impl From<&Membership> for Option<MembershipId> {
    fn from(value: &Membership) -> Option<MembershipId> {
        Some(MembershipId {
            value: value.id.clone(),
        })
    }
}
impl From<&MembershipId> for Option<MembershipId> {
    fn from(value: &MembershipId) -> Option<MembershipId> {
        use crate::spacetimedsl::Wrapper;
        Some(MembershipId::new(value.value()))
    }
}
impl From<&MembershipId> for MembershipId {
    fn from(value: &MembershipId) -> Self {
        use crate::spacetimedsl::Wrapper;
        MembershipId::new(value.value())
    }
}
impl Membership {
    ///
    pub fn get_id(&self) -> MembershipId {
        use crate::spacetimedsl::Wrapper;
        MembershipId::new(self.id.clone())
    }
    /**References the `id` column of the `account` table (`self`).

- On delete: `Error`
- On soft delete: none, the `account` table is not soft-deletable*/
    pub fn get_account_id(&self) -> AccountId {
        use crate::spacetimedsl::Wrapper;
        AccountId::new(self.account_id.clone())
    }
    /**References the `id` column of the `account` table (`self`).

- On delete: `Error`
- On soft delete: none, the `account` table is not soft-deletable*/
    pub fn set_account_id(&mut self, account_id: impl Into<AccountId>) -> AccountId {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.account_id,
            account_id.into().value(),
        );
        AccountId::new(old_value)
    }
}
