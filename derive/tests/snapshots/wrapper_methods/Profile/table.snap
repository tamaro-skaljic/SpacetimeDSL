impl Profile {
    /**References the `id` column of the `account` table (`self`).

- On delete: `Error`
- On soft delete: none, the `account` table is not soft-deletable*/
    pub fn get_account_id(&self) -> AccountId {
        use crate::spacetimedsl::Wrapper;
        AccountId::new(self.account_id.clone())
    }
    ///
    pub fn get_display_name(&self) -> &String {
        use crate::spacetimedsl::Wrapper;
        &self.display_name
    }
    ///
    pub fn get_display_name_mut(&mut self) -> &mut String {
        use crate::spacetimedsl::Wrapper;
        &mut self.display_name
    }
    ///
    pub fn set_display_name(&mut self, display_name: String) -> String {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.display_name, display_name);
        old_value
    }
}
///
pub struct CreateProfile {
    pub account_id: AccountId,
