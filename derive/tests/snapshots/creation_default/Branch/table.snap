#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct BranchId {
    value: u64,
}
impl Default for BranchId {
    fn default() -> BranchId {
        BranchId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for BranchId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "BranchId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for BranchId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Branch> for BranchId {
    fn from(value: &Branch) -> Self {
        BranchId {
            value: value.id.clone(),
        }
    }
}
impl From<&Branch> for Option<BranchId> {
    fn from(value: &Branch) -> Option<BranchId> {
        Some(BranchId {
            value: value.id.clone(),
        })
    }
}
impl From<&BranchId> for Option<BranchId> {
    fn from(value: &BranchId) -> Option<BranchId> {
        use crate::spacetimedsl::Wrapper;
        Some(BranchId::new(value.value()))
    }
}
impl From<&BranchId> for BranchId {
    fn from(value: &BranchId) -> Self {
        use crate::spacetimedsl::Wrapper;
        BranchId::new(value.value())
    }
}
impl Branch {
    ///
    pub fn get_id(&self) -> BranchId {
        use crate::spacetimedsl::Wrapper;
        BranchId::new(self.id.clone())
    }
}

