// BranchTable
impl crate::spacetimedsl::internal::References<self::BranchTable, u64> for LoanTable {}

// get_by_primary_key
impl LoanTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `loan` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        id: impl Into<LoanId> + Clone,
    ) -> Result<Loan, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_loan_by_id(id)
    }
}
