// Documentation appended to the struct:
///
/// # Foreign keys of the `loan` table
///
/// - `branch_id` references the `id` column of the `branch` table (`self`).
///   - On delete: none, the `branch` table is not deletable
///   - On soft delete: none, the `branch` table is not soft-deletable

/// The type through which the tables on the other side of this table's foreign keys
/// reach it.
#[doc(hidden)]
pub struct LoanTable;
impl crate::spacetimedsl::internal::AcceptedTable for loan__TableHandle {}
impl crate::spacetimedsl::internal::HasDeleteMethod for LoanTable {}
impl crate::spacetimedsl::internal::IsNotSoftDeletable for LoanTable {}
const _: () = {
    const _: () = {
        #[diagnostic::on_unimplemented(
            message = "the `branch` table can't be referenced, because its `#[spacetimedsl::dsl]` is rejected",
            label = "fix the error of the `branch` table first"
        )]
        trait BranchTableIsAccepted {
            const HOLDS: () = ();
        }
        #[diagnostic::do_not_recommend]
        impl<T: crate::spacetimedsl::internal::AcceptedTable> BranchTableIsAccepted
        for T {}
        const _: () = <self::branch__TableHandle as BranchTableIsAccepted>::HOLDS;
    };
    const _: () = {
        #[diagnostic::on_unimplemented(
            message = "the `branch` table has no `#[referenced_by]` naming the `loan` table",
            label = "the `branch` table doesn't know about this foreign key",
            note = "add `#[referenced_by(path = …, table = loan)]` to the primary key column of the `branch` table"
        )]
        trait ReferencedByTheLoanTable {
            const HOLDS: () = ();
        }
        #[diagnostic::do_not_recommend]
        impl<
            T: crate::spacetimedsl::internal::ReferencedBy<LoanTable>,
        > ReferencedByTheLoanTable for T {}
        const _: () = <self::BranchTable as ReferencedByTheLoanTable>::HOLDS;
    };
    const _: () = {
        #[diagnostic::on_unimplemented(
            message = "the `branch` table has a delete method, so this foreign key needs `on_delete`",
            label = "add `on_delete = …`",
            note = "`on_delete` takes `Error`, `Delete`, `SoftDelete`, `SetZero` or `Ignore`"
        )]
        trait HasNoDeleteMethod {
            const HOLDS: () = ();
        }
        #[diagnostic::do_not_recommend]
        impl<T: crate::spacetimedsl::internal::HasNoDeleteMethod> HasNoDeleteMethod
        for T {}
        const _: () = <self::BranchTable as HasNoDeleteMethod>::HOLDS;
    };
    const _: () = {
        #[diagnostic::on_unimplemented(
            message = "the `branch` table is soft-deletable, so this foreign key needs `on_soft_delete`",
            label = "add `on_soft_delete = …`",
            note = "`on_soft_delete` takes `Error`, `SoftDelete` or `Ignore`"
        )]
        trait IsNotSoftDeletable {
            const HOLDS: () = ();
        }
        #[diagnostic::do_not_recommend]
        impl<T: crate::spacetimedsl::internal::IsNotSoftDeletable> IsNotSoftDeletable
        for T {}
        const _: () = <self::BranchTable as IsNotSoftDeletable>::HOLDS;
    };
};
#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct LoanId {
    value: u64,
}
impl Default for LoanId {
    fn default() -> LoanId {
        LoanId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for LoanId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "LoanId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for LoanId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Loan> for LoanId {
    fn from(value: &Loan) -> Self {
        LoanId { value: value.id.clone() }
    }
}
impl From<&Loan> for Option<LoanId> {
    fn from(value: &Loan) -> Option<LoanId> {
        Some(LoanId { value: value.id.clone() })
    }
}
impl From<&LoanId> for Option<LoanId> {
    fn from(value: &LoanId) -> Option<LoanId> {
        use crate::spacetimedsl::Wrapper;
        Some(LoanId::new(value.value()))
    }
}
impl From<&LoanId> for LoanId {
    fn from(value: &LoanId) -> Self {
        use crate::spacetimedsl::Wrapper;
        LoanId::new(value.value())
    }
}
