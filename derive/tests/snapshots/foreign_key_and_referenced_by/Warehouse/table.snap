#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct WarehouseId {
    value: u64,
}
impl Default for WarehouseId {
    fn default() -> WarehouseId {
        WarehouseId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for WarehouseId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "WarehouseId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, WarehouseId> for WarehouseId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Warehouse> for WarehouseId {
    fn from(value: &Warehouse) -> Self {
        WarehouseId {
            value: value.id.clone(),
        }
    }
}
impl From<&Warehouse> for Option<WarehouseId> {
    fn from(value: &Warehouse) -> Option<WarehouseId> {
        Some(WarehouseId {
            value: value.id.clone(),
        })
    }
}
impl From<&WarehouseId> for Option<WarehouseId> {
    fn from(value: &WarehouseId) -> Option<WarehouseId> {
        use spacetimedsl::Wrapper;
        Some(WarehouseId::new(value.value()))
    }
}
impl From<&WarehouseId> for WarehouseId {
    fn from(value: &WarehouseId) -> Self {
        use spacetimedsl::Wrapper;
        WarehouseId::new(value.value())
    }
}
impl Warehouse {
    ///
    pub fn get_id(&self) -> WarehouseId {
        use spacetimedsl::Wrapper;
        WarehouseId::new(self.id.clone())
    }
    ///
    pub fn get_name(&self) -> &String {
        use spacetimedsl::Wrapper;
        &self.name
    }
    ///
    pub fn get_name_mut(&mut self) -> &mut String {
        use spacetimedsl::Wrapper;
        &mut self.name
    }
    ///
    pub fn set_name(&mut self, name: String) -> String {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.name, name);
        old_value
    }
}
