impl WarehouseId {
    /**Get all `Inspection` rows whose `warehouse_id` column references this `WarehouseId`.

Use it like `warehouse_id.get_inspections(&dsl)`.*/
    pub fn get_inspections<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Vec<Inspection> {
        dsl.into().get_inspections_by_warehouse_id(self).collect()
    }
}
impl InspectionId {
    /**Get the row of the `warehouse` table which the `warehouse_id` column of the `Inspection` row with this `InspectionId` references.

Use it like `inspection_id.get_warehouse(&dsl)`.*/
    pub fn get_warehouse<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::warehouse__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let inspection = dsl.get_inspection_by_id(self)?;
        dsl.get_warehouse_by_id(inspection.get_warehouse_id())
    }
}
