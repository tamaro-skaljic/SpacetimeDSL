#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct InspectionId {
    value: u64,
}
impl Default for InspectionId {
    fn default() -> InspectionId {
        InspectionId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for InspectionId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "InspectionId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, InspectionId> for InspectionId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Inspection> for InspectionId {
    fn from(value: &Inspection) -> Self {
        InspectionId {
            value: value.id.clone(),
        }
    }
}
impl From<&Inspection> for Option<InspectionId> {
    fn from(value: &Inspection) -> Option<InspectionId> {
        Some(InspectionId {
            value: value.id.clone(),
        })
    }
}
impl From<&InspectionId> for Option<InspectionId> {
    fn from(value: &InspectionId) -> Option<InspectionId> {
        use spacetimedsl::Wrapper;
        Some(InspectionId::new(value.value()))
    }
}
impl From<&InspectionId> for InspectionId {
    fn from(value: &InspectionId) -> Self {
        use spacetimedsl::Wrapper;
        InspectionId::new(value.value())
    }
}
impl Inspection {
    ///
    pub fn get_id(&self) -> InspectionId {
        use spacetimedsl::Wrapper;
        InspectionId::new(self.id.clone())
    }
    ///
    pub fn get_warehouse_id(&self) -> WarehouseId {
        use spacetimedsl::Wrapper;
        WarehouseId::new(self.warehouse_id.clone())
    }
    ///
    pub fn set_warehouse_id(
        &mut self,
        warehouse_id: impl Into<WarehouseId>,
    ) -> WarehouseId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.warehouse_id,
            warehouse_id.into().value(),
        );
        WarehouseId::new(old_value)
    }
}
