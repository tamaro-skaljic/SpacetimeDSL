pub trait this_compilation_error_occurs_because_the_shipment_table_has_no_foreign_key_attribute_referencing_the_warehouse_table {}
#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct ShipmentId {
    value: u64,
}
impl Default for ShipmentId {
    fn default() -> ShipmentId {
        ShipmentId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ShipmentId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ShipmentId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, ShipmentId> for ShipmentId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Shipment> for ShipmentId {
    fn from(value: &Shipment) -> Self {
        ShipmentId {
            value: value.id.clone(),
        }
    }
}
impl From<&Shipment> for Option<ShipmentId> {
    fn from(value: &Shipment) -> Option<ShipmentId> {
        Some(ShipmentId {
            value: value.id.clone(),
        })
    }
}
impl From<&ShipmentId> for Option<ShipmentId> {
    fn from(value: &ShipmentId) -> Option<ShipmentId> {
        use spacetimedsl::Wrapper;
        Some(ShipmentId::new(value.value()))
    }
}
impl From<&ShipmentId> for ShipmentId {
    fn from(value: &ShipmentId) -> Self {
        use spacetimedsl::Wrapper;
        ShipmentId::new(value.value())
    }
}
impl Shipment {
    ///
    pub fn get_id(&self) -> ShipmentId {
        use spacetimedsl::Wrapper;
        ShipmentId::new(self.id.clone())
    }
    ///
    pub fn get_origin_warehouse_id(&self) -> WarehouseId {
        use spacetimedsl::Wrapper;
        WarehouseId::new(self.origin_warehouse_id.clone())
    }
    ///
    pub fn set_origin_warehouse_id(
        &mut self,
        origin_warehouse_id: impl Into<WarehouseId>,
    ) -> WarehouseId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.origin_warehouse_id,
            origin_warehouse_id.into().value(),
        );
        WarehouseId::new(old_value)
    }
    ///
    pub fn get_destination_warehouse_id(&self) -> WarehouseId {
        use spacetimedsl::Wrapper;
        WarehouseId::new(self.destination_warehouse_id.clone())
    }
    ///
    pub fn set_destination_warehouse_id(
        &mut self,
        destination_warehouse_id: impl Into<WarehouseId>,
    ) -> WarehouseId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.destination_warehouse_id,
            destination_warehouse_id.into().value(),
        );
        WarehouseId::new(old_value)
    }
}
///
pub struct CreateShipment {
    pub origin_warehouse_id: WarehouseId,
    pub destination_warehouse_id: WarehouseId,
}

