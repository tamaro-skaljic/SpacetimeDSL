Use it like `shipment_id.get_destination_warehouse(&dsl)`.*/
    pub fn get_destination_warehouse<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::warehouse__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let shipment = dsl.get_shipment_by_id(self)?;
        if shipment.destination_warehouse_id == 0 {
            return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                table_name: "warehouse".into(),
                column_names_and_row_values: format!("{{ id : {} }}", 0).into(),
            });
        }
        dsl.get_warehouse_by_id(shipment.get_destination_warehouse_id())
    }
}
