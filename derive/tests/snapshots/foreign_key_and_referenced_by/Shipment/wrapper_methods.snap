impl WarehouseId {
    /**Get all `Shipment` rows whose `origin_warehouse_id` column references this `WarehouseId`.

Use it like `warehouse_id.get_shipments_by_origin_warehouse_id(&dsl)`.*/
    pub fn get_shipments_by_origin_warehouse_id<
        'a,
        T: 'a + crate::spacetimedsl::ReadContext,
    >(&self, dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>) -> Vec<Shipment> {
        dsl.into().get_shipments_by_origin_warehouse_id(self).collect()
    }
}
impl WarehouseId {
    /**Get all `Shipment` rows whose `destination_warehouse_id` column references this `WarehouseId`.

Use it like `warehouse_id.get_shipments_by_destination_warehouse_id(&dsl)`.*/
    pub fn get_shipments_by_destination_warehouse_id<
        'a,
        T: 'a + crate::spacetimedsl::ReadContext,
    >(&self, dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>) -> Vec<Shipment> {
        dsl.into().get_shipments_by_destination_warehouse_id(self).collect()
    }
}
impl ShipmentId {
    /**Get the row of the `warehouse` table which the `origin_warehouse_id` column of the `Shipment` row with this `ShipmentId` references.

Use it like `shipment_id.get_origin_warehouse(&dsl)`.*/
    pub fn get_origin_warehouse<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::warehouse__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let shipment = dsl.get_shipment_by_id(self)?;
        if shipment.origin_warehouse_id == 0 {
            return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                table_name: "warehouse".into(),
                column_names_and_row_values: format!("{{ id : {} }}", 0).into(),
            });
        }
        dsl.get_warehouse_by_id(shipment.get_origin_warehouse_id())
    }
}
