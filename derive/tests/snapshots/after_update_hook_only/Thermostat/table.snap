impl Thermostat {
    ///
    pub fn get_id(&self) -> ThermostatId {
        use crate::spacetimedsl::Wrapper;
        ThermostatId::new(self.id.clone())
    }
    ///
    pub fn get_target_temperature(&self) -> &u32 {
        use crate::spacetimedsl::Wrapper;
        &self.target_temperature
    }
    ///
    pub fn get_target_temperature_mut(&mut self) -> &mut u32 {
        use crate::spacetimedsl::Wrapper;
        &mut self.target_temperature
    }
    ///
    pub fn set_target_temperature(&mut self, target_temperature: u32) -> u32 {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.target_temperature,
            target_temperature,
        );
        old_value
    }
}
