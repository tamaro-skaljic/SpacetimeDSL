#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct AuthorId {
    value: u64,
}
impl Default for AuthorId {
    fn default() -> AuthorId {
        AuthorId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for AuthorId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "AuthorId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, AuthorId> for AuthorId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Author> for AuthorId {
    fn from(value: &Author) -> Self {
        AuthorId {
            value: value.id.clone(),
        }
    }
}
impl From<&Author> for Option<AuthorId> {
    fn from(value: &Author) -> Option<AuthorId> {
        Some(AuthorId {
            value: value.id.clone(),
        })
    }
}
impl From<&AuthorId> for Option<AuthorId> {
    fn from(value: &AuthorId) -> Option<AuthorId> {
        use spacetimedsl::Wrapper;
        Some(AuthorId::new(value.value()))
    }
}
impl From<&AuthorId> for AuthorId {
    fn from(value: &AuthorId) -> Self {
        use spacetimedsl::Wrapper;
        AuthorId::new(value.value())
    }
}
impl Author {
    ///
    pub fn get_id(&self) -> AuthorId {
        use spacetimedsl::Wrapper;
        AuthorId::new(self.id.clone())
    }
    ///
    pub fn get_name(&self) -> &String {
        use spacetimedsl::Wrapper;
        &self.name
    }
    ///
    pub fn get_name_mut(&mut self) -> &mut String {
        use spacetimedsl::Wrapper;
        &mut self.name
    }
    ///
    pub fn set_name(&mut self, name: String) -> String {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.name, name);
        old_value
    }
}
