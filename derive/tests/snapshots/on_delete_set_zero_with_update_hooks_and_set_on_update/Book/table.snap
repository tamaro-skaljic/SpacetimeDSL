        dsl: &crate::spacetimedsl::DSL<'_, T>,
        old_book: &Book,
        new_book: Book,
    ) -> Result<Book, crate::spacetimedsl::error::SpacetimeDSLError>;
}
pub trait AfterBookUpdateHook<T: crate::spacetimedsl::WriteContext> {
    fn after_book_update(
        dsl: &crate::spacetimedsl::DSL<'_, T>,
        old_book: &Book,
        new_book: &Book,
    ) -> Result<(), crate::spacetimedsl::error::SpacetimeDSLError>;
}

