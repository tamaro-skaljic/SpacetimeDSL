impl AuthorId {
    /**Get all `Book` rows whose `author_id` column references this `AuthorId`.

Use it like `author_id.get_books(&dsl)`.*/
    pub fn get_books<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Vec<Book> {
        dsl.into().get_books_by_author_id(self).collect()
    }
}
impl BookId {
    /**Get the row of the `author` table which the `author_id` column of the `Book` row with this `BookId` references.

Use it like `book_id.get_author(&dsl)`.*/
    pub fn get_author<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::author__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let book = dsl.get_book_by_id(self)?;
        if book.author_id == 0 {
            return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                table_name: "author".into(),
                column_names_and_row_values: format!("{{ id : {} }}", 0).into(),
            });
        }
        dsl.get_author_by_id(book.get_author_id())
    }
}
