#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct FolderId {
    value: u64,
}
impl Default for FolderId {
    fn default() -> FolderId {
        FolderId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for FolderId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "FolderId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for FolderId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Folder> for FolderId {
    fn from(value: &Folder) -> Self {
        FolderId {
            value: value.id.clone(),
        }
    }
}
impl From<&Folder> for Option<FolderId> {
    fn from(value: &Folder) -> Option<FolderId> {
        Some(FolderId {
            value: value.id.clone(),
        })
    }
}
impl From<&FolderId> for Option<FolderId> {
    fn from(value: &FolderId) -> Option<FolderId> {
        use crate::spacetimedsl::Wrapper;
        Some(FolderId::new(value.value()))
    }
}
impl From<&FolderId> for FolderId {
    fn from(value: &FolderId) -> Self {
        use crate::spacetimedsl::Wrapper;
        FolderId::new(value.value())
    }
}
impl Folder {
    ///
    pub fn get_id(&self) -> FolderId {
        use crate::spacetimedsl::Wrapper;
        FolderId::new(self.id.clone())
    }
    ///
    pub fn get_parent_folder_id(&self) -> FolderId {
        use crate::spacetimedsl::Wrapper;
        FolderId::new(self.parent_folder_id.clone())
    }
    ///
    pub fn set_parent_folder_id(
        &mut self,
        parent_folder_id: impl Into<FolderId>,
    ) -> FolderId {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.parent_folder_id,
            parent_folder_id.into().value(),
        );
        FolderId::new(old_value)
    }
    ///
    pub fn get_deleted(&self) -> &bool {
        use crate::spacetimedsl::Wrapper;
        &self.deleted
    }
}
///
pub struct CreateFolder {
    pub parent_folder_id: FolderId,
}

