impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to get a `Booking` from the `booking` table whose value matches the value from the unique single-column btree index on the `id` column.*/
    pub fn get_booking_by_id<'a>(
        &'a self,
        id: impl Into<BookingId> + Clone,
    ) -> Result<Booking, crate::spacetimedsl::error::SpacetimeDSLError> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().booking().id().find(id.clone().into().value()) {
            Some(booking) => Ok(booking),
            None => {
                return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                    table_name: "booking".into(),
                    column_names_and_row_values: format!(
                        "{{ id : {} }}", id.clone().into().value()
                    )
                        .into(),
                });
            }
        }
    }
}
