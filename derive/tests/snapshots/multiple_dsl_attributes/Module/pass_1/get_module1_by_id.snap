impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to get a `Module` from the `module1` table whose value matches the value from the unique single-column btree index on the `id` column.*/
    pub fn get_module1_by_id<'a>(
        &'a self,
        id: impl Into<ModuleId> + Clone,
    ) -> Result<Module, crate::spacetimedsl::error::SpacetimeDSLError> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().module1().id().find(id.clone().into().value()) {
            Some(module1) => Ok(module1),
            None => {
                return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                    table_name: "module1".into(),
                    column_names_and_row_values: format!(
                        "{{ , id : {}  }}", id.clone().into().value()
                    )
                        .into(),
                });
            }
        }
    }
}
