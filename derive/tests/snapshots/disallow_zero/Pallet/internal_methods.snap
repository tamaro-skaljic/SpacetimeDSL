// WarehouseTable
impl crate::spacetimedsl::internal::References<self::WarehouseTable, u64>
for PalletTable {}

// get_by_primary_key
impl PalletTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `pallet` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        id: impl Into<PalletId> + Clone,
    ) -> Result<Pallet, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_pallet_by_id(id)
    }
}
