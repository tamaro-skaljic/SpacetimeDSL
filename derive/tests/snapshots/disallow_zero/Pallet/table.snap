        use crate::spacetimedsl::Wrapper;
        &self.quantity
    }
    ///
    pub fn get_quantity_mut(&mut self) -> &mut u32 {
        use crate::spacetimedsl::Wrapper;
        &mut self.quantity
    }
    ///Writing the row through the DSL fails with a *Disallowed Value Error* if this column is `0` (`#[disallow(zero)]`).
    pub fn set_quantity(&mut self, quantity: u32) -> u32 {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.quantity, quantity);
        old_value
    }
    ///
    pub fn get_tracking_code(&self) -> &spacetimedb::Uuid {
        use crate::spacetimedsl::Wrapper;
        &self.tracking_code
    }
    /**References the `id` column of the `warehouse` table (`self`).

- On delete: none, the `warehouse` table is not deletable
- On soft delete: none, the `warehouse` table is not soft-deletable*/
    pub fn get_warehouse_id(&self) -> WarehouseId {
        use crate::spacetimedsl::Wrapper;
        WarehouseId::new(self.warehouse_id.clone())
    }
    /**References the `id` column of the `warehouse` table (`self`).

- On delete: none, the `warehouse` table is not deletable
- On soft delete: none, the `warehouse` table is not soft-deletable

Writing the row through the DSL fails with a *Disallowed Value Error* if this column is `0` (`#[disallow(zero)]`).*/
    pub fn set_warehouse_id(
        &mut self,
        warehouse_id: impl Into<WarehouseId>,
    ) -> WarehouseId {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(
            &mut self.warehouse_id,
            warehouse_id.into().value(),
        );
        WarehouseId::new(old_value)
    }
}
