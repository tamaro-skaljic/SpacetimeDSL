pub struct PalletId {
    value: u64,
}
impl Default for PalletId {
    fn default() -> PalletId {
        PalletId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for PalletId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "PalletId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for PalletId {
