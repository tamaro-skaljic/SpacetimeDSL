pub struct PalletId {
    value: u64,
}
impl Default for PalletId {
    fn default() -> PalletId {
        PalletId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for PalletId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "PalletId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for PalletId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Pallet> for PalletId {
    fn from(value: &Pallet) -> Self {
        PalletId {
            value: value.id.clone(),
        }
    }
}
impl From<&Pallet> for Option<PalletId> {
    fn from(value: &Pallet) -> Option<PalletId> {
        Some(PalletId {
            value: value.id.clone(),
        })
    }
}
impl From<&PalletId> for Option<PalletId> {
    fn from(value: &PalletId) -> Option<PalletId> {
        use crate::spacetimedsl::Wrapper;
        Some(PalletId::new(value.value()))
    }
}
impl From<&PalletId> for PalletId {
    fn from(value: &PalletId) -> Self {
        use crate::spacetimedsl::Wrapper;
        PalletId::new(value.value())
    }
}
