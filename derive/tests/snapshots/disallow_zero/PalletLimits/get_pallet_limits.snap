impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**Get the `PalletLimits` from the singleton `pallet_limits` table, or its default while no row exists.

The default is not written to the table.*/
    pub fn get_pallet_limits<'a>(
        &'a self,
    ) -> Result<PalletLimits, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().pallet_limits().id().find(&0u8) {
            Some(pallet_limits) => Ok(pallet_limits),
            None => {
                let mut pallet_limits = <PalletLimits as crate::spacetimedsl::DefaultSingleton>::get_default(
                    &crate::spacetimedsl::read_only_dsl(self.ctx()),
                )?;
                pallet_limits.id = 0u8;
                Ok(pallet_limits)
            }
        }
    }
}
