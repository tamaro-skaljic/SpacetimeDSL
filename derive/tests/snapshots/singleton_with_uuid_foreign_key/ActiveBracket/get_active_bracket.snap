impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**Get the `ActiveBracket` from the singleton `active_bracket` table, or its default while no row exists.

The default is not written to the table.*/
    pub fn get_active_bracket<'a>(
        &'a self,
    ) -> Result<ActiveBracket, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().active_bracket().id().find(&0u8) {
            Some(active_bracket) => Ok(active_bracket),
            None => {
                let mut active_bracket = <ActiveBracket as crate::spacetimedsl::DefaultSingleton>::get_default(
                    &crate::spacetimedsl::read_only_dsl(self.ctx()),
                )?;
                active_bracket.id = 0u8;
                Ok(active_bracket)
            }
        }
    }
}
