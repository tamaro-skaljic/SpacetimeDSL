// execute_on_delete_strategies_of_the_active_bracket_table_after_one_row_of_the_bracket_table_was_deleted
impl crate::spacetimedsl::internal::DSLInternals {
    ///Execute On Delete Strategies of the referencing table `active_bracket` after one row of the referenced table `bracket` was deleted.
    pub fn execute_on_delete_strategies_of_the_active_bracket_table_after_one_row_of_the_bracket_table_was_deleted<
        'a,
        T: crate::spacetimedsl::WriteContext,
    >(
        dsl: &crate::spacetimedsl::DSL<'_, T>,
        strategy: &crate::spacetimedsl::delete::OnDeleteStrategy,
        primary_key_value_of_a_row_of_another_table_to_delete: &Uuid,
    ) -> Result<
        Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        crate::spacetimedsl::delete::OnDeleteStrategyFailure<
            Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        >,
    > {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        use crate::spacetimedsl::itertools::Itertools;
        let mut entries = vec![];
        let mut error_from_hook: Option<
            Box<crate::spacetimedsl::error::SpacetimeDSLError>,
        > = None;
        let mut error = false;
        'outer: {
            match &strategy {
                crate::spacetimedsl::delete::OnDeleteStrategy::Error => {
                    match dsl
                        .db()
                        .active_bracket()
                        .id()
                        .find(&0u8)
                        .filter(|row| {
                            row.seed_bracket_id
                                == *primary_key_value_of_a_row_of_another_table_to_delete
                        })
                    {
                        None => {}
                        Some(row) => {
                            error = true;
                            let child_entries = vec![];
                            let id = &row.id;
                            entries
                                .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                    table_name: "active_bracket".into(),
                                    column_name: "seed_bracket_id".into(),
                                    strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Error,
                                    row_value: "0".to_string().into(),
                                    child_entries: child_entries,
                                });
                        }
                    };
                }
                crate::spacetimedsl::delete::OnDeleteStrategy::Delete => {
                    match dsl
                        .db()
                        .active_bracket()
                        .id()
                        .find(&0u8)
                        .filter(|row| {
                            row.bracket_id
                                == *primary_key_value_of_a_row_of_another_table_to_delete
                        })
                    {
                        None => {}
                        Some(row) => {
                            let child_entries = vec![];
                            let id = &row.id;
                            entries
                                .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                    table_name: "active_bracket".into(),
                                    column_name: "bracket_id".into(),
                                    strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                                    row_value: "0".to_string().into(),
                                    child_entries: child_entries,
                                });
                            dsl.db().active_bracket().id().delete(row.id);
                        }
                    };
                }
                crate::spacetimedsl::delete::OnDeleteStrategy::SoftDelete => {}
                crate::spacetimedsl::delete::OnDeleteStrategy::SetZero => {}
                crate::spacetimedsl::delete::OnDeleteStrategy::Ignore => {}
            };
        }
        match error {
            false => Ok(entries),
            true => {
                Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                    entries: entries,
                    error_from_hook: error_from_hook,
                })
            }
        }
    }
}

// execute_on_delete_strategies_of_the_active_bracket_table_after_multiple_rows_of_the_bracket_table_were_deleted
impl crate::spacetimedsl::internal::DSLInternals {
    ///Execute On Delete Strategies of the referencing table `active_bracket` after multiple rows of the referenced table `bracket` were deleted.
    pub fn execute_on_delete_strategies_of_the_active_bracket_table_after_multiple_rows_of_the_bracket_table_were_deleted<
        'a,
        T: crate::spacetimedsl::WriteContext,
    >(
        dsl: &crate::spacetimedsl::DSL<'_, T>,
        strategy: &crate::spacetimedsl::delete::OnDeleteStrategy,
        primary_key_values_of_rows_of_another_table_to_delete: &'a [Uuid],
    ) -> Result<
        std::collections::HashMap<
            &'a Uuid,
            Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        >,
        crate::spacetimedsl::delete::OnDeleteStrategyFailure<
            std::collections::HashMap<
                &'a Uuid,
                Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
            >,
        >,
    > {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        use crate::spacetimedsl::itertools::Itertools;
        let mut entries = std::collections::HashMap::new();
        for primary_key_value_of_a_row_of_another_table_to_delete in primary_key_values_of_rows_of_another_table_to_delete {
            entries
                .insert(primary_key_value_of_a_row_of_another_table_to_delete, vec![]);
        }
        let mut error_from_hook: Option<
            Box<crate::spacetimedsl::error::SpacetimeDSLError>,
        > = None;
        let mut error = false;
        'outer: {
            match &strategy {
                crate::spacetimedsl::delete::OnDeleteStrategy::Error => {
                    for primary_key_value_of_a_row_of_another_table_to_delete in primary_key_values_of_rows_of_another_table_to_delete {
                        match dsl
                            .db()
                            .active_bracket()
                            .id()
                            .find(&0u8)
                            .filter(|row| {
                                row.seed_bracket_id
                                    == *primary_key_value_of_a_row_of_another_table_to_delete
                            })
                        {
                            None => {}
                            Some(row) => {
                                error = true;
                                let child_entries = vec![];
                                let id = &row.id;
                                entries
                                    .get_mut(
                                        primary_key_value_of_a_row_of_another_table_to_delete,
                                    )
                                    .unwrap_or_else(|| {
                                        panic!(
                                            "every primary key value of a removed row of the referenced table was given an entry list before its strategies ran, which does not hold for {}",
                                            primary_key_value_of_a_row_of_another_table_to_delete
                                        )
                                    })
                                    .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                        table_name: "active_bracket".into(),
                                        column_name: "seed_bracket_id".into(),
                                        strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Error,
                                        row_value: "0".to_string().into(),
                                        child_entries: child_entries,
                                    });
                            }
                        };
                    }
                }
                crate::spacetimedsl::delete::OnDeleteStrategy::Delete => {
                    for primary_key_value_of_a_row_of_another_table_to_delete in primary_key_values_of_rows_of_another_table_to_delete {
                        match dsl
                            .db()
                            .active_bracket()
                            .id()
                            .find(&0u8)
                            .filter(|row| {
                                row.bracket_id
                                    == *primary_key_value_of_a_row_of_another_table_to_delete
                            })
                        {
                            None => {}
                            Some(row) => {
                                let child_entries = vec![];
                                let id = &row.id;
                                entries
                                    .get_mut(
                                        primary_key_value_of_a_row_of_another_table_to_delete,
                                    )
                                    .unwrap_or_else(|| {
                                        panic!(
                                            "every primary key value of a removed row of the referenced table was given an entry list before its strategies ran, which does not hold for {}",
                                            primary_key_value_of_a_row_of_another_table_to_delete
                                        )
                                    })
                                    .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                        table_name: "active_bracket".into(),
                                        column_name: "bracket_id".into(),
                                        strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                                        row_value: "0".to_string().into(),
                                        child_entries: child_entries,
                                    });
                                dsl.db().active_bracket().id().delete(row.id);
                            }
                        };
                    }
                }
                crate::spacetimedsl::delete::OnDeleteStrategy::SoftDelete => {}
                crate::spacetimedsl::delete::OnDeleteStrategy::SetZero => {}
                crate::spacetimedsl::delete::OnDeleteStrategy::Ignore => {}
            };
        }
        match error {
            false => Ok(entries),
            true => {
                Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                    entries: entries,
                    error_from_hook: error_from_hook,
                })
            }
        }
    }
}
