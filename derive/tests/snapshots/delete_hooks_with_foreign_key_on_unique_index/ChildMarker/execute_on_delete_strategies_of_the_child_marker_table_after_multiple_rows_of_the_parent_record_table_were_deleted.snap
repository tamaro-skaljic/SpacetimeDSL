---
source: derive/src/characterization_tests.rs
---
impl crate::spacetimedsl::internal::DSLInternals {
    ///Execute On Delete Strategies of the referencing table `child_marker` after multiple rows of the referenced table `parent_record` were deleted.
    pub fn execute_on_delete_strategies_of_the_child_marker_table_after_multiple_rows_of_the_parent_record_table_were_deleted<
        'a,
        T: crate::spacetimedsl::WriteContext,
    >(
        dsl: &crate::spacetimedsl::DSL<'_, T>,
        strategy: &crate::spacetimedsl::delete::OnDeleteStrategy,
        primary_key_values_of_rows_of_another_table_to_delete: &'a [u64],
    ) -> Result<
        std::collections::HashMap<
            &'a u64,
            Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        >,
        std::collections::HashMap<
            &'a u64,
            Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        >,
    > {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        use self::this_compilation_error_occurs_because_the_parent_record_table_has_no_referenced_by_attribute_referencing_the_child_marker_table;
        use ::spacetimedsl::itertools::Itertools;
        let mut entries = std::collections::HashMap::new();
        for primary_key_value_of_a_row_of_another_table_to_delete in primary_key_values_of_rows_of_another_table_to_delete {
            entries
                .insert(primary_key_value_of_a_row_of_another_table_to_delete, vec![]);
        }
        let mut error = false;
        'outer: {
            match &strategy {
                crate::spacetimedsl::OnDeleteStrategy::Error => {}
                crate::spacetimedsl::OnDeleteStrategy::Delete => {
                    use self::BeforeChildMarkerDeleteHook;
                    use self::AfterChildMarkerDeleteHook;
                    for primary_key_value_of_a_row_of_another_table_to_delete in primary_key_values_of_rows_of_another_table_to_delete {
                        match dsl
                            .db()
                            .child_marker()
                            .parent_id()
                            .find(primary_key_value_of_a_row_of_another_table_to_delete)
                        {
                            None => {}
                            Some(row) => {
                                let child_entries = vec![];
                                let id = &row.id;
                                entries
                                    .get_mut(
                                        primary_key_value_of_a_row_of_another_table_to_delete,
                                    )
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_of_another_table_to_delete} should exist in entries."
                                        ),
                                    )
                                    .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                        table_name: "child_marker".into(),
                                        column_name: "parent_id".into(),
                                        strategy: crate::spacetimedsl::OnDeleteStrategy::Delete,
                                        row_value: format!("{}", ChildMarkerId::new(id.clone()))
                                            .into(),
                                        child_entries,
                                    });
                                if crate::spacetimedsl::DSLMethodHooks::before_child_marker_delete(
                                        &dsl,
                                        &row,
                                    )
                                    .is_err()
                                {
                                    error = true;
                                    break 'outer;
                                }
                                dsl.db().child_marker().id().delete(row.id);
                                if crate::spacetimedsl::DSLMethodHooks::after_child_marker_delete(
                                        &dsl,
                                        &row,
                                    )
                                    .is_err()
                                {
                                    error = true;
                                    break 'outer;
                                }
                            }
                        };
                    }
                }
                crate::spacetimedsl::OnDeleteStrategy::SetZero => {}
                crate::spacetimedsl::OnDeleteStrategy::Ignore => {}
            };
        }
        match error {
            false => Ok(entries),
            true => Err(entries),
        }
    }
}
