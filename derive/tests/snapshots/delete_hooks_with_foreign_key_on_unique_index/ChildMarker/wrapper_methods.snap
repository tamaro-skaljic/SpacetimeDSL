impl ParentRecordId {
    /**Get the `ChildMarker` whose `parent_id` column references this `ParentRecordId`.

Use it like `parent_record_id.get_child_marker(&dsl)`.*/
    pub fn get_child_marker<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<ChildMarker, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.into().get_child_marker_by_parent_id(self)
    }
}
impl ChildMarkerId {
    /**Get the row of the `parent_record` table which the `parent_id` column of the `ChildMarker` row with this `ChildMarkerId` references.

Use it like `child_marker_id.get_parent_record(&dsl)`.*/
    pub fn get_parent_record<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::parent_record__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let child_marker = dsl.get_child_marker_by_id(self)?;
        dsl.get_parent_record_by_id(child_marker.get_parent_id())
    }
}
