}
impl ChildMarker {
    ///
    pub fn get_id(&self) -> ChildMarkerId {
        use spacetimedsl::Wrapper;
        ChildMarkerId::new(self.id.clone())
    }
    ///
    pub fn get_parent_id(&self) -> ParentRecordId {
        use spacetimedsl::Wrapper;
        ParentRecordId::new(self.parent_id.clone())
    }
    ///
    pub fn set_parent_id(
        &mut self,
        parent_id: impl Into<ParentRecordId>,
    ) -> ParentRecordId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.parent_id, parent_id.into().value());
        ParentRecordId::new(old_value)
    }
}
