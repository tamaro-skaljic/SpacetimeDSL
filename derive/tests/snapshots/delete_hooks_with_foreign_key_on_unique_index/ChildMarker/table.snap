}
impl Default for ChildMarkerId {
    fn default() -> ChildMarkerId {
        ChildMarkerId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ChildMarkerId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ChildMarkerId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, ChildMarkerId> for ChildMarkerId {
    fn new(value: u64) -> Self {
