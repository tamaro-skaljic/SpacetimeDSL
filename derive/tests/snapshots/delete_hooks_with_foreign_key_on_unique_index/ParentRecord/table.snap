pub trait this_compilation_error_occurs_because_the_parent_record_table_is_not_deletable_or_has_no_referenced_by_attribute_referencing_the_child_marker_table {}
#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct ParentRecordId {
    value: u64,
}
impl Default for ParentRecordId {
    fn default() -> ParentRecordId {
        ParentRecordId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ParentRecordId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ParentRecordId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, ParentRecordId> for ParentRecordId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&ParentRecord> for ParentRecordId {
    fn from(value: &ParentRecord) -> Self {
        ParentRecordId {
            value: value.id.clone(),
        }
    }
}
impl From<&ParentRecord> for Option<ParentRecordId> {
    fn from(value: &ParentRecord) -> Option<ParentRecordId> {
        Some(ParentRecordId {
            value: value.id.clone(),
        })
    }
}
impl From<&ParentRecordId> for Option<ParentRecordId> {
    fn from(value: &ParentRecordId) -> Option<ParentRecordId> {
        use spacetimedsl::Wrapper;
        Some(ParentRecordId::new(value.value()))
    }
}
impl From<&ParentRecordId> for ParentRecordId {
    fn from(value: &ParentRecordId) -> Self {
        use spacetimedsl::Wrapper;
        ParentRecordId::new(value.value())
    }
}
impl ParentRecord {
    ///
    pub fn get_id(&self) -> ParentRecordId {
        use spacetimedsl::Wrapper;
        ParentRecordId::new(self.id.clone())
    }
}

