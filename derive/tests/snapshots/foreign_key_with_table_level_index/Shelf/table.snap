    ::spacetimedb::SpacetimeType
)]
pub struct ShelfId {
    value: u64,
}
impl Default for ShelfId {
    fn default() -> ShelfId {
        ShelfId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ShelfId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ShelfId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for ShelfId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Shelf> for ShelfId {
    fn from(value: &Shelf) -> Self {
        ShelfId { value: value.id.clone() }
    }
}
impl From<&Shelf> for Option<ShelfId> {
    fn from(value: &Shelf) -> Option<ShelfId> {
        Some(ShelfId { value: value.id.clone() })
    }
}
impl From<&ShelfId> for Option<ShelfId> {
    fn from(value: &ShelfId) -> Option<ShelfId> {
        use crate::spacetimedsl::Wrapper;
        Some(ShelfId::new(value.value()))
    }
}
impl From<&ShelfId> for ShelfId {
    fn from(value: &ShelfId) -> Self {
        use crate::spacetimedsl::Wrapper;
        ShelfId::new(value.value())
    }
}
impl Shelf {
    ///
    pub fn get_id(&self) -> ShelfId {
        use crate::spacetimedsl::Wrapper;
        ShelfId::new(self.id.clone())
    }
}

