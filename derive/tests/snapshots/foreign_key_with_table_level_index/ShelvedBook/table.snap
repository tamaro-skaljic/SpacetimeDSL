#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct ShelvedBookId {
    value: u64,
}
impl Default for ShelvedBookId {
    fn default() -> ShelvedBookId {
        ShelvedBookId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ShelvedBookId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ShelvedBookId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for ShelvedBookId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&ShelvedBook> for ShelvedBookId {
    fn from(value: &ShelvedBook) -> Self {
        ShelvedBookId {
            value: value.id.clone(),
        }
    }
}
impl From<&ShelvedBook> for Option<ShelvedBookId> {
    fn from(value: &ShelvedBook) -> Option<ShelvedBookId> {
        Some(ShelvedBookId {
            value: value.id.clone(),
        })
    }
}
impl From<&ShelvedBookId> for Option<ShelvedBookId> {
    fn from(value: &ShelvedBookId) -> Option<ShelvedBookId> {
        use crate::spacetimedsl::Wrapper;
        Some(ShelvedBookId::new(value.value()))
    }
}
impl From<&ShelvedBookId> for ShelvedBookId {
    fn from(value: &ShelvedBookId) -> Self {
        use crate::spacetimedsl::Wrapper;
        ShelvedBookId::new(value.value())
    }
}
impl ShelvedBook {
    ///
    pub fn get_id(&self) -> ShelvedBookId {
        use crate::spacetimedsl::Wrapper;
        ShelvedBookId::new(self.id.clone())
    }
    /**References the `id` column of the `shelf` table (`self`).

- On delete: `Delete`
- On soft delete: none, the `shelf` table is not soft-deletable*/
    pub fn get_shelf_id(&self) -> ShelfId {
        use crate::spacetimedsl::Wrapper;
        ShelfId::new(self.shelf_id.clone())
    }
}
///
pub struct CreateShelvedBook {
    pub shelf_id: ShelfId,
}

