impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**Get the `ActiveTournament` from the singleton `active_tournament` table, or its default while no row exists.

The default is not written to the table.*/
    pub fn get_active_tournament<'a>(
        &'a self,
    ) -> Result<ActiveTournament, crate::spacetimedsl::error::SpacetimeDSLError> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().active_tournament().id().find(&0u8) {
            Some(active_tournament) => Ok(active_tournament),
            None => {
                let mut active_tournament = <ActiveTournament as crate::spacetimedsl::DefaultSingleton>::get_default(
                    &crate::spacetimedsl::read_only_dsl(self.ctx()),
                )?;
                active_tournament.id = 0u8;
                Ok(active_tournament)
            }
        }
    }
}
