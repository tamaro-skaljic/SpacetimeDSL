pub trait this_compilation_error_occurs_because_the_server_binding_table_has_no_foreign_key_attribute_with_on_delete_defined_referencing_the_region_table {}
impl ServerBinding {
    ///
    pub fn get_region_id(&self) -> RegionId {
        use spacetimedsl::Wrapper;
        RegionId::new(self.region_id.clone())
    }
    ///
    pub fn set_region_id(&mut self, region_id: impl Into<RegionId>) -> RegionId {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.region_id, region_id.into().value());
        RegionId::new(old_value)
    }
}
///
pub struct CreateServerBinding {
    pub region_id: RegionId,
}

