#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct RegionId {
    value: u64,
}
impl Default for RegionId {
    fn default() -> RegionId {
        RegionId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for RegionId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "RegionId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, RegionId> for RegionId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Region> for RegionId {
    fn from(value: &Region) -> Self {
        RegionId {
            value: value.id.clone(),
        }
    }
}
impl From<&Region> for Option<RegionId> {
    fn from(value: &Region) -> Option<RegionId> {
        Some(RegionId {
            value: value.id.clone(),
        })
    }
}
impl From<&RegionId> for Option<RegionId> {
    fn from(value: &RegionId) -> Option<RegionId> {
        use spacetimedsl::Wrapper;
        Some(RegionId::new(value.value()))
    }
}
impl From<&RegionId> for RegionId {
    fn from(value: &RegionId) -> Self {
        use spacetimedsl::Wrapper;
        RegionId::new(value.value())
    }
}
impl Region {
    ///
    pub fn get_id(&self) -> RegionId {
        use spacetimedsl::Wrapper;
        RegionId::new(self.id.clone())
    }
    ///
    pub fn get_name(&self) -> &String {
        use spacetimedsl::Wrapper;
        &self.name
    }
    ///
    pub fn get_name_mut(&mut self) -> &mut String {
        use spacetimedsl::Wrapper;
        &mut self.name
    }
    ///
    pub fn set_name(&mut self, name: String) -> String {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.name, name);
        old_value
    }
}
