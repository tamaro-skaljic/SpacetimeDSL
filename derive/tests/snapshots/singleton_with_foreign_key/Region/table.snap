    }
}
impl std::fmt::Display for RegionId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "RegionId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for RegionId {
    fn new(value: u64) -> Self {
