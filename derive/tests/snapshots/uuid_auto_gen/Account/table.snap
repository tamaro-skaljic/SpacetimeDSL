#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct AccountId {
    value: Uuid,
}
impl AccountId {
    /// Generate a random UUID v4.
    pub fn v4(
        dsl: &crate::spacetimedsl::DSL<'_, impl crate::spacetimedsl::WriteContext>,
    ) -> Result<Self, crate::spacetimedsl::error::SpacetimeDSLError> {
        Ok(Self {
            value: crate::spacetimedsl::NewUUID::new_uuid_v4(dsl.ctx())?,
        })
    }
    /// Generate a UUID v7, which sorts in the order the values were generated.
    pub fn v7(
        dsl: &crate::spacetimedsl::DSL<'_, impl crate::spacetimedsl::WriteContext>,
    ) -> Result<Self, crate::spacetimedsl::error::SpacetimeDSLError> {
        Ok(Self {
            value: crate::spacetimedsl::NewUUID::new_uuid_v7(dsl.ctx())?,
        })
    }
}
impl std::fmt::Display for AccountId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "AccountId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<Uuid, AccountId> for AccountId {
    fn new(value: Uuid) -> Self {
        Self { value }
    }
    fn value(&self) -> Uuid {
        self.value.clone()
    }
}
impl From<&Account> for AccountId {
    fn from(value: &Account) -> Self {
        AccountId {
            value: value.id.clone(),
        }
    }
}
impl From<&Account> for Option<AccountId> {
    fn from(value: &Account) -> Option<AccountId> {
        Some(AccountId {
            value: value.id.clone(),
        })
    }
}
impl From<&AccountId> for Option<AccountId> {
    fn from(value: &AccountId) -> Option<AccountId> {
        use spacetimedsl::Wrapper;
        Some(AccountId::new(value.value()))
    }
}
impl From<&AccountId> for AccountId {
    fn from(value: &AccountId) -> Self {
        use spacetimedsl::Wrapper;
        AccountId::new(value.value())
    }
}
impl Account {
    ///
    pub fn get_id(&self) -> AccountId {
        use spacetimedsl::Wrapper;
        AccountId::new(self.id.clone())
    }
    ///
    pub fn get_name(&self) -> &String {
        use spacetimedsl::Wrapper;
        &self.name
    }
    ///
    pub fn get_name_mut(&mut self) -> &mut String {
        use spacetimedsl::Wrapper;
        &mut self.name
    }
    ///
    pub fn set_name(&mut self, name: String) -> String {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.name, name);
        old_value
    }
}
