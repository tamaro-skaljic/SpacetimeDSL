impl AccountId {
    /**Get all `SessionToken` rows whose `account_id` column references this `AccountId`.

Use it like `account_id.get_session_tokens(&dsl)`.*/
    pub fn get_session_tokens<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Vec<SessionToken> {
        dsl.into().get_session_tokens_by_account_id(self).collect()
    }
}
impl SessionTokenId {
    /**Get the row of the `account` table which the `account_id` column of the `SessionToken` row with this `SessionTokenId` references.

Use it like `session_token_id.get_account(&dsl)`.*/
    pub fn get_account<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::account__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let session_token = dsl.get_session_token_by_id(self)?;
        if session_token.account_id == ::spacetimedb::Uuid::NIL {
            return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                table_name: "account".into(),
                column_names_and_row_values: format!(
                    "{{ id : {} }}", ::spacetimedb::Uuid::NIL
                )
                    .into(),
            });
        }
        dsl.get_account_by_id(session_token.get_account_id())
    }
}
