#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct InstallationId {
    value: Uuid,
}
impl InstallationId {
    /// Generate a random UUID v4.
    pub fn v4(
        dsl: &crate::spacetimedsl::DSL<'_, impl crate::spacetimedsl::WriteContext>,
    ) -> Result<Self, crate::spacetimedsl::error::SpacetimeDSLError> {
        Ok(Self {
            value: crate::spacetimedsl::NewUUID::new_uuid_v4(dsl.ctx())?,
        })
    }
    /// Generate a UUID v7, which sorts in the order the values were generated.
    pub fn v7(
        dsl: &crate::spacetimedsl::DSL<'_, impl crate::spacetimedsl::WriteContext>,
    ) -> Result<Self, crate::spacetimedsl::error::SpacetimeDSLError> {
        Ok(Self {
            value: crate::spacetimedsl::NewUUID::new_uuid_v7(dsl.ctx())?,
        })
    }
}
impl std::fmt::Display for InstallationId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "InstallationId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<Uuid, InstallationId> for InstallationId {
    fn new(value: Uuid) -> Self {
        Self { value }
    }
    fn value(&self) -> Uuid {
        self.value.clone()
    }
}
impl From<&Installation> for InstallationId {
    fn from(value: &Installation) -> Self {
        InstallationId {
            value: value.installation_id.clone(),
        }
    }
}
impl From<&Installation> for Option<InstallationId> {
    fn from(value: &Installation) -> Option<InstallationId> {
        Some(InstallationId {
            value: value.installation_id.clone(),
        })
    }
}
impl From<&InstallationId> for Option<InstallationId> {
    fn from(value: &InstallationId) -> Option<InstallationId> {
        use spacetimedsl::Wrapper;
        Some(InstallationId::new(value.value()))
    }
}
impl From<&InstallationId> for InstallationId {
    fn from(value: &InstallationId) -> Self {
        use spacetimedsl::Wrapper;
        InstallationId::new(value.value())
    }
}
impl Installation {
    ///
    pub fn get_installation_id(&self) -> InstallationId {
        use spacetimedsl::Wrapper;
        InstallationId::new(self.installation_id.clone())
    }
    ///
    pub fn get_name(&self) -> &String {
        use spacetimedsl::Wrapper;
        &self.name
    }
    ///
    pub fn get_name_mut(&mut self) -> &mut String {
        use spacetimedsl::Wrapper;
        &mut self.name
    }
    ///
    pub fn set_name(&mut self, name: String) -> String {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.name, name);
        old_value
    }
}
///
pub struct CreateInstallation {
    pub name: String,
}

