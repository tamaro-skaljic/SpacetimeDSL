// get_by_primary_key
impl ReminderTimerTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `reminder_timer` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        scheduled_id: impl Into<ReminderTimerScheduledId> + Clone,
    ) -> Result<ReminderTimer, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_reminder_timer_by_scheduled_id(scheduled_id)
    }
}
