// get_by_primary_key
impl CleanupTimerTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `cleanup_timer` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        scheduled_id: impl Into<CleanupTimerScheduledId> + Clone,
    ) -> Result<CleanupTimer, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_cleanup_timer_by_scheduled_id(scheduled_id)
    }
}
