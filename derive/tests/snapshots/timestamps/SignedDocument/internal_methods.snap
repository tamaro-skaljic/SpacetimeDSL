// get_by_primary_key
impl SignedDocumentTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `signed_document` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        id: impl Into<SignedDocumentId> + Clone,
    ) -> Result<SignedDocument, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_signed_document_by_id(id)
    }
}
