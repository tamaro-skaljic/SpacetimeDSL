pub struct GuestId {
    value: u64,
}
impl Default for GuestId {
    fn default() -> GuestId {
        GuestId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for GuestId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "GuestId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for GuestId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Guest> for GuestId {
    fn from(value: &Guest) -> Self {
        GuestId { value: value.id.clone() }
    }
}
impl From<&Guest> for Option<GuestId> {
    fn from(value: &Guest) -> Option<GuestId> {
