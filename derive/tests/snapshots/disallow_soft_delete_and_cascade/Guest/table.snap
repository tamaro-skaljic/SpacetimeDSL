        use crate::spacetimedsl::Wrapper;
        &mut self.remaining_visits
    }
    ///Writing the row through the DSL fails with a *Disallowed Value Error* if this column increases (`#[disallow(increasing)]`).
    pub fn set_remaining_visits(&mut self, remaining_visits: u8) -> u8 {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.remaining_visits, remaining_visits);
        old_value
    }
    ///
    pub fn get_deleted(&self) -> &bool {
        use crate::spacetimedsl::Wrapper;
        &self.deleted
    }
}
