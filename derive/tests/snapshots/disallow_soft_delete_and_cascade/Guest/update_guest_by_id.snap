impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to update a `Guest` row of the `guest` table whose value matches the value from the unique single-column btree index on the `id` column.

# Disallowed values

Fails with a *Disallowed Value Error* if a column holds what its `#[disallow]` forbids:

- `remaining_visits`: an increase

# Foreign keys

Fails with `ReferenceIntegrityViolation` unless each of these columns references a row whenever its value changes:

- `guild_id`: a row of the `guild` table (`self`), or `0`*/
    pub fn update_guest_by_id<'a>(
        &'a self,
        guest: Guest,
    ) -> Result<Guest, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        let mut guest = guest;
        let mut the_same_or_another_guest: Option<Guest> = None;
        let guild_id = guest.get_guild_id().value();
        if guild_id.ne(&0) {
            if the_same_or_another_guest.is_none() {
                the_same_or_another_guest = match self
                    .db()
                    .guest()
                    .id()
                    .find(guest.get_id().value())
                {
                    Some(guest) => Some(guest),
                    None => {
                        return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                            table_name: "guest".into(),
                            column_names_and_row_values: format!(
                                "{{ id : {} }}", guest.get_id().value()
                            )
                                .into(),
                        });
                    }
                };
            }
            if the_same_or_another_guest
                .as_ref()
                .expect(
                    "the stored row is looked up by its primary key before the row to write is compared with it",
                )
                .get_guild_id()
                .ne(&guest.get_guild_id())
            {
                match self.get_guild_by_id(guest.get_guild_id()) {
                    Ok(_) => {}
                    Err(_) => {
                        return Err(
                            crate::spacetimedsl::error::SpacetimeDSLError::ReferenceIntegrityViolation(crate::spacetimedsl::error::ReferenceIntegrityViolationError::OnCreateOrUpdate {
                                table_name: "guest".into(),
                                create_or_update: crate::spacetimedsl::error::CreateOrUpdate::Update,
                                column_names_and_row_values: format!(
                                    "{{ guild_id : {} }}", guild_id
                                )
                                    .into(),
                            }),
                        );
                    }
                };
            }
        }
        if the_same_or_another_guest.is_none() {
            the_same_or_another_guest = match self
                .db()
                .guest()
                .id()
                .find(guest.get_id().value())
            {
                Some(guest) => Some(guest),
                None => {
                    return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                        table_name: "guest".into(),
                        column_names_and_row_values: format!(
                            "{{ id : {} }}", guest.get_id().value()
                        )
                            .into(),
                    });
                }
            };
        }
        let stored_row = the_same_or_another_guest
            .as_ref()
            .expect(
                "the stored row is looked up by its primary key before the row to write is compared with it",
            );
        if guest.remaining_visits > stored_row.remaining_visits {
            return Err(
                crate::spacetimedsl::error::SpacetimeDSLError::Error(
                    format!(
                        "Disallowed Value Error while trying to update the row `{}` in the `guest` table because `remaining_visits` would increase from `{}` to `{}`, which `#[disallow(increasing)]` forbids!",
                        format!("{{ id : {} }}", guest.id), stored_row.remaining_visits,
                        guest.remaining_visits
                    ),
                ),
            );
        }
        let guest = self.db().guest().id().update(guest);
        Ok(guest)
    }
}
