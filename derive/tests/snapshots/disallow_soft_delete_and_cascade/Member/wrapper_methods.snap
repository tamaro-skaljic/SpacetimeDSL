impl GuildId {
    /**Get all `Member` rows whose `guild_id` column references this `GuildId`.

Use it like `guild_id.get_members(&dsl)`.*/
    pub fn get_members<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Vec<Member> {
        dsl.into().get_members_by_guild_id(self).collect()
    }
}
impl MemberId {
    /**Get the row of the `guild` table which the `guild_id` column of the `Member` row with this `MemberId` references.

Use it like `member_id.get_guild(&dsl)`.*/
    pub fn get_guild<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::guild__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let member = dsl.get_member_by_id(self)?;
        if member.guild_id == 0 {
            return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                table_name: "guild".into(),
                column_names_and_row_values: format!("{{ id : {} }}", 0).into(),
            });
        }
        dsl.get_guild_by_id(member.get_guild_id())
    }
}
