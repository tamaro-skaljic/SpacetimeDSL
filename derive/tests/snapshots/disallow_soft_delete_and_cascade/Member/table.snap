        GuildId::new(self.guild_id.clone())
    }
    /**References the `id` column of the `guild` table (`self`).

- On delete: `SetZero`
- On soft delete: `SoftDelete`*/
    pub fn set_guild_id(&mut self, guild_id: impl Into<GuildId>) -> GuildId {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.guild_id, guild_id.into().value());
        GuildId::new(old_value)
