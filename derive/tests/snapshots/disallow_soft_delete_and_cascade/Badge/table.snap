#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct BadgeId {
    value: u64,
}
impl Default for BadgeId {
    fn default() -> BadgeId {
        BadgeId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for BadgeId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "BadgeId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for BadgeId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Badge> for BadgeId {
    fn from(value: &Badge) -> Self {
        BadgeId { value: value.id.clone() }
    }
}
impl From<&Badge> for Option<BadgeId> {
    fn from(value: &Badge) -> Option<BadgeId> {
        Some(BadgeId { value: value.id.clone() })
    }
}
impl From<&BadgeId> for Option<BadgeId> {
    fn from(value: &BadgeId) -> Option<BadgeId> {
        use crate::spacetimedsl::Wrapper;
        Some(BadgeId::new(value.value()))
    }
}
impl From<&BadgeId> for BadgeId {
    fn from(value: &BadgeId) -> Self {
        use crate::spacetimedsl::Wrapper;
        BadgeId::new(value.value())
    }
}
impl Badge {
    ///
    pub fn get_id(&self) -> BadgeId {
        use crate::spacetimedsl::Wrapper;
        BadgeId::new(self.id.clone())
    }
    /**References the `id` column of the `member` table (`self`).

- On delete: none, the `member` table is not deletable
- On soft delete: `Ignore`*/
    pub fn get_member_id(&self) -> MemberId {
