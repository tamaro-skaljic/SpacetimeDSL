pub struct GuildId {
    value: u64,
}
impl Default for GuildId {
    fn default() -> GuildId {
        GuildId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for GuildId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "GuildId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for GuildId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Guild> for GuildId {
    fn from(value: &Guild) -> Self {
        GuildId { value: value.id.clone() }
    }
}
impl From<&Guild> for Option<GuildId> {
    fn from(value: &Guild) -> Option<GuildId> {
        Some(GuildId { value: value.id.clone() })
    }
}
impl From<&GuildId> for Option<GuildId> {
    fn from(value: &GuildId) -> Option<GuildId> {
        use crate::spacetimedsl::Wrapper;
        Some(GuildId::new(value.value()))
    }
}
impl From<&GuildId> for GuildId {
    fn from(value: &GuildId) -> Self {
        use crate::spacetimedsl::Wrapper;
        GuildId::new(value.value())
    }
}
impl Guild {
    ///
    pub fn get_id(&self) -> GuildId {
        use crate::spacetimedsl::Wrapper;
        GuildId::new(self.id.clone())
    }
    ///
    pub fn get_deleted(&self) -> &bool {
        use crate::spacetimedsl::Wrapper;
        &self.deleted
    }
