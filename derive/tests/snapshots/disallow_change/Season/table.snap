#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct SeasonId {
    value: u64,
}
impl Default for SeasonId {
    fn default() -> SeasonId {
        SeasonId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for SeasonId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "SeasonId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for SeasonId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Season> for SeasonId {
    fn from(value: &Season) -> Self {
        SeasonId {
            value: value.id.clone(),
        }
    }
}
impl From<&Season> for Option<SeasonId> {
    fn from(value: &Season) -> Option<SeasonId> {
        Some(SeasonId {
            value: value.id.clone(),
        })
    }
}
impl From<&SeasonId> for Option<SeasonId> {
    fn from(value: &SeasonId) -> Option<SeasonId> {
        use crate::spacetimedsl::Wrapper;
        Some(SeasonId::new(value.value()))
    }
}
impl From<&SeasonId> for SeasonId {
    fn from(value: &SeasonId) -> Self {
        use crate::spacetimedsl::Wrapper;
        SeasonId::new(value.value())
    }
}
impl Season {
    ///
    pub fn get_id(&self) -> SeasonId {
        use crate::spacetimedsl::Wrapper;
        SeasonId::new(self.id.clone())
    }
    ///
    pub fn get_number(&self) -> &u32 {
        use crate::spacetimedsl::Wrapper;
        &self.number
    }
    ///
    pub fn get_number_mut(&mut self) -> &mut u32 {
        use crate::spacetimedsl::Wrapper;
        &mut self.number
    }
    ///Writing the row through the DSL fails with a *Disallowed Value Error* if this column decreases (`#[disallow(decreasing)]`).
    pub fn set_number(&mut self, number: u32) -> u32 {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.number, number);
        old_value
    }
}
///
pub struct CreateSeason {
    pub number: u32,
}
pub trait BeforeSeasonUpdateHook<T: crate::spacetimedsl::WriteContext> {
    fn before_season_update(
        dsl: &crate::spacetimedsl::DSL<'_, T>,
        old_season: &Season,
        new_season: Season,
    ) -> Result<Season, crate::spacetimedsl::error::SpacetimeDSLError>;
}

