impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**Get the `League` from the singleton `league` table, or its default while no row exists.

The default is not written to the table.*/
    pub fn get_league<'a>(
        &'a self,
    ) -> Result<League, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().league().id().find(&0u8) {
            Some(league) => Ok(league),
            None => {
                let mut league = <League as crate::spacetimedsl::DefaultSingleton>::get_default(
                    &crate::spacetimedsl::read_only_dsl(self.ctx()),
                )?;
                league.id = 0u8;
                Ok(league)
            }
        }
    }
}
