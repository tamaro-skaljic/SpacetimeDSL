#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct CurrencyId {
    value: u64,
}
impl Default for CurrencyId {
    fn default() -> CurrencyId {
        CurrencyId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for CurrencyId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "CurrencyId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for CurrencyId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Currency> for CurrencyId {
    fn from(value: &Currency) -> Self {
        CurrencyId {
            value: value.id.clone(),
        }
    }
}
impl From<&Currency> for Option<CurrencyId> {
    fn from(value: &Currency) -> Option<CurrencyId> {
        Some(CurrencyId {
            value: value.id.clone(),
        })
    }
}
impl From<&CurrencyId> for Option<CurrencyId> {
    fn from(value: &CurrencyId) -> Option<CurrencyId> {
        use crate::spacetimedsl::Wrapper;
        Some(CurrencyId::new(value.value()))
    }
}
impl From<&CurrencyId> for CurrencyId {
    fn from(value: &CurrencyId) -> Self {
        use crate::spacetimedsl::Wrapper;
        CurrencyId::new(value.value())
    }
}
impl Currency {
    ///
    pub fn get_id(&self) -> CurrencyId {
        use crate::spacetimedsl::Wrapper;
        CurrencyId::new(self.id.clone())
    }
}

