impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to update a `Session` row of the `session` table whose value matches the value from the unique single-column hash index on the `device_id` column.*/
    pub fn update_session_by_device_id<'a>(
        &'a self,
        session: Session,
    ) -> Result<Session, crate::spacetimedsl::error::SpacetimeDSLError> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        let mut session = session;
        let session = self.db().session().device_id().update(session);
        Ok(session)
    }
}
