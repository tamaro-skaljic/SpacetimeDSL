    fn from(value: &LabelId) -> Option<LabelId> {
        use spacetimedsl::Wrapper;
        Some(LabelId::new(value.value()))
    }
}
impl From<&LabelId> for LabelId {
    fn from(value: &LabelId) -> Self {
        use spacetimedsl::Wrapper;
        LabelId::new(value.value())
    }
}
