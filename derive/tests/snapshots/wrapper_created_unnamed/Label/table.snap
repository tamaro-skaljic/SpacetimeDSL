    }
}
impl std::fmt::Display for LabelId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "LabelId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, LabelId> for LabelId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Label> for LabelId {
    fn from(value: &Label) -> Self {
        LabelId { value: value.id.clone() }
    }
}
impl From<&Label> for Option<LabelId> {
