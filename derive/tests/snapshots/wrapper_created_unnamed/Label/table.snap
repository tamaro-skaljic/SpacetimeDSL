impl Label {
    ///
    pub fn get_id(&self) -> LabelId {
        use spacetimedsl::Wrapper;
        LabelId::new(self.id.clone())
    }
    ///
    pub fn get_caption(&self) -> LabelCaption {
        use spacetimedsl::Wrapper;
        LabelCaption::new(self.caption.clone())
    }
    ///
    pub fn set_caption(&mut self, caption: String) -> LabelCaption {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.caption, caption);
        LabelCaption::new(old_value)
    }
    ///
    pub fn get_code(&self) -> LabelCode {
        use spacetimedsl::Wrapper;
        LabelCode::new(self.code.clone())
    }
    ///
    pub fn set_code(&mut self, code: u64) -> LabelCode {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.code, code);
        LabelCode::new(old_value)
    }
}
