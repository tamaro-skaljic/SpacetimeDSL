impl CountryCode {
    /**Get the `Embassy` whose `country_code` column references this `CountryCode`.

Use it like `country_code.get_embassy(&dsl)`.*/
    pub fn get_embassy<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<Embassy, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.into()
            .get_embassy_by_country_code(&crate::spacetimedsl::Wrapper::value(self))
    }
}
impl EmbassyId {
    /**Get the row of the `country` table which the `country_code` column of the `Embassy` row with this `EmbassyId` references.

Use it like `embassy_id.get_country(&dsl)`.*/
    pub fn get_country<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::country__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let embassy = dsl.get_embassy_by_id(self)?;
        self::CountryTable::get_by_primary_key(&dsl, &embassy.country_code)
    }
}
