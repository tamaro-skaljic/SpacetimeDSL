impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to get a `Embassy` from the `embassy` table whose value matches the value from the unique single-column btree index on the `country_code` column.*/
    pub fn get_embassy_by_country_code<'a>(
        &'a self,
        country_code: &str,
    ) -> Result<Embassy, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().embassy().country_code().find(country_code.to_string()) {
            Some(embassy) => Ok(embassy),
            None => {
                return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                    table_name: "embassy".into(),
                    column_names_and_row_values: format!(
                        "{{ country_code : {} }}", country_code.to_string()
                    )
                        .into(),
                });
            }
        }
    }
}
