    ::spacetimedb::SpacetimeType
)]
pub struct EmbassyId {
    value: u64,
}
impl Default for EmbassyId {
    fn default() -> EmbassyId {
        EmbassyId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for EmbassyId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "EmbassyId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for EmbassyId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Embassy> for EmbassyId {
    fn from(value: &Embassy) -> Self {
        EmbassyId {
            value: value.id.clone(),
        }
    }
}
impl From<&Embassy> for Option<EmbassyId> {
    fn from(value: &Embassy) -> Option<EmbassyId> {
        Some(EmbassyId {
            value: value.id.clone(),
        })
    }
}
impl From<&EmbassyId> for Option<EmbassyId> {
    fn from(value: &EmbassyId) -> Option<EmbassyId> {
        use crate::spacetimedsl::Wrapper;
        Some(EmbassyId::new(value.value()))
    }
}
impl From<&EmbassyId> for EmbassyId {
    fn from(value: &EmbassyId) -> Self {
        use crate::spacetimedsl::Wrapper;
        EmbassyId::new(value.value())
    }
}
impl Embassy {
    ///
