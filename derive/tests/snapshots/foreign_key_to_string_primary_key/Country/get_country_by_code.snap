impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to get a `Country` from the `country` table whose value matches the value from the unique single-column btree index on the `code` column.*/
    pub fn get_country_by_code<'a>(
        &'a self,
        code: &str,
    ) -> Result<Country, crate::spacetimedsl::error::SpacetimeDSLError> {
        use crate::spacetimedsl::Wrapper;
        use ::spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        match self.db().country().code().find(code.to_string()) {
            Some(country) => Ok(country),
            None => {
                return Err(crate::spacetimedsl::error::SpacetimeDSLError::NotFoundError {
                    table_name: "country".into(),
                    column_names_and_row_values: format!(
                        "{{ code : {} }}", code.to_string()
                    )
                        .into(),
                });
            }
        }
    }
}
