/// The type through which the tables on the other side of this table's foreign keys
/// reach it.
#[doc(hidden)]
pub struct CountryTable;
#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct CountryCode {
    value: String,
}
impl Default for CountryCode {
    fn default() -> CountryCode {
        CountryCode {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for CountryCode {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "CountryCode", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<String> for CountryCode {
    fn new(value: String) -> Self {
        Self { value }
    }
    fn value(&self) -> String {
        self.value.clone()
    }
}
impl From<&Country> for CountryCode {
    fn from(value: &Country) -> Self {
        CountryCode {
            value: value.code.clone(),
        }
    }
}
impl From<&Country> for Option<CountryCode> {
    fn from(value: &Country) -> Option<CountryCode> {
        Some(CountryCode {
            value: value.code.clone(),
        })
    }
}
impl From<&CountryCode> for Option<CountryCode> {
    fn from(value: &CountryCode) -> Option<CountryCode> {
        use crate::spacetimedsl::Wrapper;
        Some(CountryCode::new(value.value()))
    }
}
impl From<&CountryCode> for CountryCode {
    fn from(value: &CountryCode) -> Self {
        use crate::spacetimedsl::Wrapper;
        CountryCode::new(value.value())
    }
}
impl Country {
    ///
    pub fn get_code(&self) -> CountryCode {
        use crate::spacetimedsl::Wrapper;
        CountryCode::new(self.code.clone())
    }
    ///
    pub fn get_continent(&self) -> &String {
        use crate::spacetimedsl::Wrapper;
        &self.continent
    }
    ///
    pub fn get_continent_mut(&mut self) -> &mut String {
        use crate::spacetimedsl::Wrapper;
        &mut self.continent
    }
    ///
    pub fn set_continent(&mut self, continent: String) -> String {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.continent, continent);
        old_value
    }
}
///
pub struct CreateCountry {
    pub code: String,
    pub continent: String,
}

