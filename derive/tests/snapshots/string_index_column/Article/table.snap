#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct ArticleId {
    value: u64,
}
impl Default for ArticleId {
    fn default() -> ArticleId {
        ArticleId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ArticleId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ArticleId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, ArticleId> for ArticleId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Article> for ArticleId {
    fn from(value: &Article) -> Self {
        ArticleId {
            value: value.id.clone(),
        }
    }
}
impl From<&Article> for Option<ArticleId> {
    fn from(value: &Article) -> Option<ArticleId> {
        Some(ArticleId {
            value: value.id.clone(),
        })
    }
}
impl From<&ArticleId> for Option<ArticleId> {
    fn from(value: &ArticleId) -> Option<ArticleId> {
        use spacetimedsl::Wrapper;
        Some(ArticleId::new(value.value()))
    }
}
impl From<&ArticleId> for ArticleId {
    fn from(value: &ArticleId) -> Self {
        use spacetimedsl::Wrapper;
        ArticleId::new(value.value())
    }
}
