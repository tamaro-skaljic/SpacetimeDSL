impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    /**

Try to update a `Article` row of the `article` table whose value matches the value from the unique single-column btree index on the `id` column.*/
    pub fn update_article_by_id<'a>(
        &'a self,
        article: Article,
    ) -> Result<Article, crate::spacetimedsl::error::SpacetimeDSLError> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        let mut article = article;
        let article = self.db().article().id().update(article);
        Ok(article)
    }
}
