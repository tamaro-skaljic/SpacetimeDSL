// execute_on_delete_strategies_of_the_book_table_after_one_row_of_the_author_table_was_deleted
impl crate::spacetimedsl::internal::DSLInternals {
    ///Execute On Delete Strategies of the referencing table `book` after one row of the referenced table `author` was deleted.
    pub fn execute_on_delete_strategies_of_the_book_table_after_one_row_of_the_author_table_was_deleted<
        'a,
        T: crate::spacetimedsl::WriteContext,
    >(
        dsl: &crate::spacetimedsl::DSL<'_, T>,
        strategy: &crate::spacetimedsl::delete::OnDeleteStrategy,
        primary_key_value_of_a_row_of_another_table_to_delete: &u64,
    ) -> Result<
        Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        crate::spacetimedsl::delete::OnDeleteStrategyFailure<
            Vec<crate::spacetimedsl::delete::DeletionResultEntry>,
        >,
    > {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        use self::this_compilation_error_occurs_because_the_author_table_is_not_deletable_or_has_no_referenced_by_attribute_referencing_the_book_table;
        use ::spacetimedsl::itertools::Itertools;
        let mut entries = vec![];
        let mut error_from_hook: Option<
            Box<crate::spacetimedsl::error::SpacetimeDSLError>,
        > = None;
        let mut error = false;
        'outer: {
            match &strategy {
                crate::spacetimedsl::delete::OnDeleteStrategy::Error => {}
                crate::spacetimedsl::delete::OnDeleteStrategy::Delete => {
                    let mut child_entries_by_primary_key_value_of_row_to_delete = std::collections::HashMap::new();
                    let mut row_to_delete_by_primary_key_value = std::collections::HashMap::new();
                    let mut primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete = std::collections::HashMap::new();
                    primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete
                        .insert(
                            primary_key_value_of_a_row_of_another_table_to_delete,
                            vec![],
                        );
                    for row in dsl
                        .db()
                        .book()
                        .author_id()
                        .filter(primary_key_value_of_a_row_of_another_table_to_delete)
                    {
                        if !child_entries_by_primary_key_value_of_row_to_delete
                            .contains_key(&row.id)
                        {
                            primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete
                                .get_mut(
                                    primary_key_value_of_a_row_of_another_table_to_delete,
                                )
                                .expect(
                                    &format!(
                                        "{primary_key_value_of_a_row_of_another_table_to_delete} should exist in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete."
                                    ),
                                )
                                .push(row.id);
                            child_entries_by_primary_key_value_of_row_to_delete
                                .insert(row.id, vec![]);
                            row_to_delete_by_primary_key_value.insert(row.id, row);
                        }
                    }
                    let primary_key_values_of_rows_to_delete = child_entries_by_primary_key_value_of_row_to_delete
                        .keys()
                        .cloned()
                        .collect_vec();
                    match crate::spacetimedsl::internal::DSLInternals::execute_on_delete_strategies_of_referencing_tables_after_multiple_rows_of_the_book_table_were_deleted(
                        dsl,
                        crate::spacetimedsl::delete::OnDeleteStrategy::Error,
                        &primary_key_values_of_rows_to_delete[..],
                    ) {
                        Err(failure) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in failure.entries {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                            if error_from_hook.is_none() {
                                error_from_hook = failure.error_from_hook;
                            }
                            for (
                                primary_key_value_of_a_row_of_another_table_to_delete,
                                primary_key_values_of_rows_to_delete,
                            ) in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete {
                                for id in &primary_key_values_of_rows_to_delete {
                                    let child_entries = child_entries_by_primary_key_value_of_row_to_delete
                                        .remove(&id)
                                        .expect(
                                            &"id should exist in child_entries_by_primary_key_value_of_row_to_delete.",
                                        );
                                    entries
                                        .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                            table_name: "book".into(),
                                            column_name: "author_id".into(),
                                            strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                                            row_value: format!("{}", BookId::new(id.clone())).into(),
                                            child_entries,
                                        });
                                }
                            }
                            return Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                                entries: entries,
                                error_from_hook: error_from_hook,
                            });
                        }
                        Ok(child_entries_by_primary_key_value_of_a_row_to_delete) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in child_entries_by_primary_key_value_of_a_row_to_delete {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                        }
                    };
                    for id in &primary_key_values_of_rows_to_delete {
                        let row = row_to_delete_by_primary_key_value
                            .get(id)
                            .expect("Should exist");
                        if !dsl.db().book().id().delete(id) {
                            for (
                                primary_key_value_of_a_row_of_another_table_to_delete,
                                primary_key_values_of_rows_to_delete,
                            ) in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete {
                                for id in &primary_key_values_of_rows_to_delete {
                                    let child_entries = child_entries_by_primary_key_value_of_row_to_delete
                                        .remove(&id)
                                        .expect(
                                            &"id should exist in child_entries_by_primary_key_value_of_row_to_delete.",
                                        );
                                    entries
                                        .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                            table_name: "book".into(),
                                            column_name: "author_id".into(),
                                            strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                                            row_value: format!("{}", BookId::new(id.clone())).into(),
                                            child_entries,
                                        });
                                }
                            }
                            return Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                                entries: entries,
                                error_from_hook: error_from_hook,
                            });
                        }
                    }
                    match crate::spacetimedsl::internal::DSLInternals::execute_on_delete_strategies_of_referencing_tables_after_multiple_rows_of_the_book_table_were_deleted(
                        dsl,
                        crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                        &primary_key_values_of_rows_to_delete[..],
                    ) {
                        Err(failure) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in failure.entries {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                            if error_from_hook.is_none() {
                                error_from_hook = failure.error_from_hook;
                            }
                            for (
                                primary_key_value_of_a_row_of_another_table_to_delete,
                                primary_key_values_of_rows_to_delete,
                            ) in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete {
                                for id in &primary_key_values_of_rows_to_delete {
                                    let child_entries = child_entries_by_primary_key_value_of_row_to_delete
                                        .remove(&id)
                                        .expect(
                                            &"id should exist in child_entries_by_primary_key_value_of_row_to_delete.",
                                        );
                                    entries
                                        .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                            table_name: "book".into(),
                                            column_name: "author_id".into(),
                                            strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                                            row_value: format!("{}", BookId::new(id.clone())).into(),
                                            child_entries,
                                        });
                                }
                            }
                            return Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                                entries: entries,
                                error_from_hook: error_from_hook,
                            });
                        }
                        Ok(child_entries_by_primary_key_value_of_a_row_to_delete) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in child_entries_by_primary_key_value_of_a_row_to_delete {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                        }
                    };
                    match crate::spacetimedsl::internal::DSLInternals::execute_on_delete_strategies_of_referencing_tables_after_multiple_rows_of_the_book_table_were_deleted(
                        dsl,
                        crate::spacetimedsl::delete::OnDeleteStrategy::SetZero,
                        &primary_key_values_of_rows_to_delete[..],
                    ) {
                        Err(failure) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in failure.entries {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                            if error_from_hook.is_none() {
                                error_from_hook = failure.error_from_hook;
                            }
                            for (
                                primary_key_value_of_a_row_of_another_table_to_delete,
                                primary_key_values_of_rows_to_delete,
                            ) in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete {
                                for id in &primary_key_values_of_rows_to_delete {
                                    let child_entries = child_entries_by_primary_key_value_of_row_to_delete
                                        .remove(&id)
                                        .expect(
                                            &"id should exist in child_entries_by_primary_key_value_of_row_to_delete.",
                                        );
                                    entries
                                        .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                            table_name: "book".into(),
                                            column_name: "author_id".into(),
                                            strategy: crate::spacetimedsl::delete::OnDeleteStrategy::Delete,
                                            row_value: format!("{}", BookId::new(id.clone())).into(),
                                            child_entries,
                                        });
                                }
                            }
                            return Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                                entries: entries,
                                error_from_hook: error_from_hook,
                            });
                        }
                        Ok(child_entries_by_primary_key_value_of_a_row_to_delete) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in child_entries_by_primary_key_value_of_a_row_to_delete {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
