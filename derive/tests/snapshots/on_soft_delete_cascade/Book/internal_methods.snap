                            return Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                                entries: entries,
                                error_from_hook: error_from_hook,
                            });
                        }
                        Ok(child_entries_by_primary_key_value_of_a_row_to_delete) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in child_entries_by_primary_key_value_of_a_row_to_delete {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                        }
                    };
                    match crate::spacetimedsl::internal::DSLInternals::execute_on_delete_strategies_of_referencing_tables_after_multiple_rows_of_the_book_table_were_soft_deleted(
                        dsl,
                        crate::spacetimedsl::delete::OnDeleteStrategy::Ignore,
                        &primary_key_values_of_rows_to_delete[..],
                    ) {
                        Err(failure) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in failure.entries {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                            if error_from_hook.is_none() {
                                error_from_hook = failure.error_from_hook;
                            }
                            for (
                                primary_key_value_of_a_row_of_another_table_to_delete,
                                primary_key_values_of_rows_to_delete,
                            ) in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete {
                                for id in &primary_key_values_of_rows_to_delete {
                                    let child_entries = child_entries_by_primary_key_value_of_row_to_delete
                                        .remove(&id)
                                        .expect(
                                            &"id should exist in child_entries_by_primary_key_value_of_row_to_delete.",
                                        );
                                    entries
                                        .get_mut(
                                            primary_key_value_of_a_row_of_another_table_to_delete,
                                        )
                                        .expect(
                                            &format!(
                                                "{primary_key_value_of_a_row_of_another_table_to_delete} should exist in entries."
                                            ),
                                        )
                                        .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                            table_name: "book".into(),
                                            column_name: "author_id".into(),
                                            strategy: crate::spacetimedsl::delete::OnDeleteStrategy::SoftDelete,
                                            row_value: format!("{}", BookId::new(id.clone())).into(),
                                            child_entries,
                                        });
                                }
                            }
                            return Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                                entries: entries,
                                error_from_hook: error_from_hook,
                            });
                        }
                        Ok(child_entries_by_primary_key_value_of_a_row_to_delete) => {
                            for (
                                primary_key_value_of_a_row_to_delete,
                                mut child_entries,
                            ) in child_entries_by_primary_key_value_of_a_row_to_delete {
                                child_entries_by_primary_key_value_of_row_to_delete
                                    .get_mut(primary_key_value_of_a_row_to_delete)
                                    .expect(
                                        &format!(
                                            "{primary_key_value_of_a_row_to_delete} should exist in child_entries_by_primary_key_value_of_row_to_delete."
                                        ),
                                    )
                                    .append(&mut child_entries);
                            }
                        }
                    };
                    for (
                        primary_key_value_of_a_row_of_another_table_to_delete,
                        primary_key_values_of_rows_to_delete,
                    ) in primary_key_values_of_rows_to_delete_by_primary_key_value_of_a_row_of_another_table_to_delete {
                        for id in &primary_key_values_of_rows_to_delete {
                            let child_entries = child_entries_by_primary_key_value_of_row_to_delete
                                .remove(&id)
                                .expect(
                                    &"id should exist in child_entries_by_primary_key_value_of_row_to_delete.",
                                );
                            entries
                                .get_mut(
                                    primary_key_value_of_a_row_of_another_table_to_delete,
                                )
                                .expect(
                                    &format!(
                                        "{primary_key_value_of_a_row_of_another_table_to_delete} should exist in entries."
                                    ),
                                )
                                .push(crate::spacetimedsl::delete::DeletionResultEntry {
                                    table_name: "book".into(),
                                    column_name: "author_id".into(),
                                    strategy: crate::spacetimedsl::delete::OnDeleteStrategy::SoftDelete,
                                    row_value: format!("{}", BookId::new(id.clone())).into(),
                                    child_entries,
                                });
                        }
                    }
                }
                crate::spacetimedsl::delete::OnDeleteStrategy::SetZero => {}
                crate::spacetimedsl::delete::OnDeleteStrategy::Ignore => {}
            };
        }
        match error {
            false => Ok(entries),
            true => {
                Err(crate::spacetimedsl::delete::OnDeleteStrategyFailure {
                    entries: entries,
                    error_from_hook: error_from_hook,
                })
            }
        }
    }
}
