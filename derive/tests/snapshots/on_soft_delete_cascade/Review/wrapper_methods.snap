impl BookId {
    /**Get all `Review` rows whose `book_id` column references this `BookId`.

Use it like `book_id.get_reviews(&dsl)`.*/
    pub fn get_reviews<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Vec<Review> {
        dsl.into().get_reviews_by_book_id(self).collect()
    }
}
impl ReviewId {
    /**Get the row of the `book` table which the `book_id` column of the `Review` row with this `ReviewId` references.

Use it like `review_id.get_book(&dsl)`.*/
    pub fn get_book<'a, T: 'a + crate::spacetimedsl::ReadContext>(
        &self,
        dsl: impl Into<crate::spacetimedsl::ReadOnlyDSL<'a, T>>,
    ) -> Result<
        <self::book__TableHandle as ::spacetimedb::Table>::Row,
        crate::spacetimedsl::error::SpacetimeDSLError,
    > {
        let dsl = dsl.into();
        let review = dsl.get_review_by_id(self)?;
        dsl.get_book_by_id(review.get_book_id())
    }
}
