#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct ReviewId {
    value: u64,
}
impl Default for ReviewId {
    fn default() -> ReviewId {
        ReviewId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ReviewId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ReviewId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for ReviewId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Review> for ReviewId {
    fn from(value: &Review) -> Self {
        ReviewId {
            value: value.id.clone(),
        }
    }
}
impl From<&Review> for Option<ReviewId> {
    fn from(value: &Review) -> Option<ReviewId> {
        Some(ReviewId {
            value: value.id.clone(),
        })
    }
}
impl From<&ReviewId> for Option<ReviewId> {
    fn from(value: &ReviewId) -> Option<ReviewId> {
        use crate::spacetimedsl::Wrapper;
        Some(ReviewId::new(value.value()))
    }
}
impl From<&ReviewId> for ReviewId {
    fn from(value: &ReviewId) -> Self {
        use crate::spacetimedsl::Wrapper;
        ReviewId::new(value.value())
    }
}
impl Review {
    ///
    pub fn get_id(&self) -> ReviewId {
        use crate::spacetimedsl::Wrapper;
        ReviewId::new(self.id.clone())
    }
    /**References the `id` column of the `book` table (`self`).

- On delete: `Delete`
- On soft delete: `Ignore`*/
    pub fn get_book_id(&self) -> BookId {
        use crate::spacetimedsl::Wrapper;
        BookId::new(self.book_id.clone())
    }
    /**References the `id` column of the `book` table (`self`).

- On delete: `Delete`
- On soft delete: `Ignore`*/
    pub fn set_book_id(&mut self, book_id: impl Into<BookId>) -> BookId {
        use crate::spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.book_id, book_id.into().value());
        BookId::new(old_value)
    }
}
///
pub struct CreateReview {
    pub book_id: BookId,
}

