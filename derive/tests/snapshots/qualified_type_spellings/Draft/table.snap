#[derive(
    Clone,
    Debug,
    PartialEq,
    PartialOrd,
    Eq,
    Ord,
    Hash,
    ::spacetimedb::SpacetimeType
)]
pub struct DraftId {
    value: u64,
}
impl Default for DraftId {
    fn default() -> DraftId {
        DraftId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for DraftId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "DraftId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64> for DraftId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Draft> for DraftId {
    fn from(value: &Draft) -> Self {
        DraftId { value: value.id.clone() }
    }
}
impl From<&Draft> for Option<DraftId> {
    fn from(value: &Draft) -> Option<DraftId> {
        Some(DraftId { value: value.id.clone() })
    }
}
impl From<&DraftId> for Option<DraftId> {
    fn from(value: &DraftId) -> Option<DraftId> {
        use crate::spacetimedsl::Wrapper;
        Some(DraftId::new(value.value()))
    }
}
impl From<&DraftId> for DraftId {
    fn from(value: &DraftId) -> Self {
        use crate::spacetimedsl::Wrapper;
        DraftId::new(value.value())
    }
}
impl Draft {
    ///
    pub fn get_id(&self) -> DraftId {
        use crate::spacetimedsl::Wrapper;
        DraftId::new(self.id.clone())
    }
}

