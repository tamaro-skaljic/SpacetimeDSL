impl<T: crate::spacetimedsl::WriteContext> crate::spacetimedsl::DSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Get a `Document` iterator that contains all rows in the `document` table whose value matches the value from the single-column btree index on the `qualified_title` column.
    pub fn get_documents_by_qualified_title<'a>(
        &'a self,
        qualified_title: &'a str,
    ) -> impl Iterator<Item = Document> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        self.db().document().qualified_title().filter(qualified_title)
    }
}
impl<T: crate::spacetimedsl::ReadContext> crate::spacetimedsl::ReadOnlyDSL<'_, T> {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Get a `Document` iterator that contains all rows in the `document` table whose value matches the value from the single-column btree index on the `qualified_title` column.
    pub fn get_documents_by_qualified_title<'a>(
        &'a self,
        qualified_title: &'a str,
    ) -> impl Iterator<Item = Document> {
        use ::spacetimedsl::Wrapper;
        use spacetimedb::{CtxDbRead, CtxDbWrite, Table as _};
        self.db().document().qualified_title().filter(qualified_title)
    }
}
