#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct ReminderId {
    value: u64,
}
impl Default for ReminderId {
    fn default() -> ReminderId {
        ReminderId {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ReminderId {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ReminderId", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<u64, ReminderId> for ReminderId {
    fn new(value: u64) -> Self {
        Self { value }
    }
    fn value(&self) -> u64 {
        self.value.clone()
    }
}
impl From<&Reminder> for ReminderId {
    fn from(value: &Reminder) -> Self {
        ReminderId {
            value: value.id.clone(),
        }
    }
}
impl From<&Reminder> for Option<ReminderId> {
    fn from(value: &Reminder) -> Option<ReminderId> {
        Some(ReminderId {
            value: value.id.clone(),
        })
    }
}
impl From<&ReminderId> for Option<ReminderId> {
    fn from(value: &ReminderId) -> Option<ReminderId> {
        use spacetimedsl::Wrapper;
        Some(ReminderId::new(value.value()))
    }
}
impl From<&ReminderId> for ReminderId {
    fn from(value: &ReminderId) -> Self {
        use spacetimedsl::Wrapper;
        ReminderId::new(value.value())
    }
}
#[derive(Clone, Debug, PartialEq, PartialOrd, Eq, Ord, Hash, spacetimedb::SpacetimeType)]
pub struct ReminderAcknowledgedAt {
    value: Option<Timestamp>,
}
impl Default for ReminderAcknowledgedAt {
    fn default() -> ReminderAcknowledgedAt {
        ReminderAcknowledgedAt {
            value: Default::default(),
        }
    }
}
impl std::fmt::Display for ReminderAcknowledgedAt {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{} {{ id: {:?} }}", "ReminderAcknowledgedAt", self.value)
    }
}
impl crate::spacetimedsl::Wrapper<Option<Timestamp>, ReminderAcknowledgedAt>
for ReminderAcknowledgedAt {
    fn new(value: Option<Timestamp>) -> Self {
        Self { value }
    }
    fn value(&self) -> Option<Timestamp> {
        self.value.clone()
    }
}
impl From<&Reminder> for ReminderAcknowledgedAt {
    fn from(value: &Reminder) -> Self {
        ReminderAcknowledgedAt {
            value: value.acknowledged_at.clone(),
        }
    }
}
impl From<&Reminder> for Option<ReminderAcknowledgedAt> {
    fn from(value: &Reminder) -> Option<ReminderAcknowledgedAt> {
        Some(ReminderAcknowledgedAt {
            value: value.acknowledged_at.clone(),
        })
    }
}
impl From<&ReminderAcknowledgedAt> for Option<ReminderAcknowledgedAt> {
    fn from(value: &ReminderAcknowledgedAt) -> Option<ReminderAcknowledgedAt> {
        use spacetimedsl::Wrapper;
        Some(ReminderAcknowledgedAt::new(value.value()))
    }
}
impl From<&ReminderAcknowledgedAt> for ReminderAcknowledgedAt {
    fn from(value: &ReminderAcknowledgedAt) -> Self {
        use spacetimedsl::Wrapper;
        ReminderAcknowledgedAt::new(value.value())
    }
}
impl Reminder {
    ///
    pub fn get_id(&self) -> ReminderId {
        use spacetimedsl::Wrapper;
        ReminderId::new(self.id.clone())
    }
    ///
    pub fn get_acknowledged_at(&self) -> Option<ReminderAcknowledgedAt> {
        use spacetimedsl::Wrapper;
        match &self.acknowledged_at {
            None => None,
            Some(value) => Some(ReminderAcknowledgedAt::new(Some(value.clone()))),
        }
    }
    ///
    pub fn set_acknowledged_at(
        &mut self,
        acknowledged_at: Option<Timestamp>,
    ) -> ReminderAcknowledgedAt {
        use spacetimedsl::Wrapper;
        let old_value = std::mem::replace(&mut self.acknowledged_at, acknowledged_at);
        ReminderAcknowledgedAt::new(old_value)
    }
    ///
    pub fn get_due_at(&self) -> Option<ReminderDueAt> {
        use spacetimedsl::Wrapper;
        match &self.due_at {
            None => None,
            Some(value) => Some(ReminderDueAt::new(value.clone())),
        }
    }
    ///
    pub fn set_due_at(
        &mut self,
        due_at: impl Into<Option<ReminderDueAt>>,
    ) -> Option<ReminderDueAt> {
        use spacetimedsl::Wrapper;
        let due_at = due_at.into();
        let mut due_at_option = None;
        if due_at.is_some() {
            due_at_option = Some(
                Into::<ReminderDueAt>::into(due_at.expect("value should exist")).value(),
            );
        }
        let due_at = due_at_option;
        let old_value = std::mem::replace(&mut self.due_at, due_at);
        match old_value {
            Some(old_value) => Some(ReminderDueAt::new(old_value)),
            None => None,
        }
    }
}
///
pub struct CreateReminder {
    pub acknowledged_at: Option<Timestamp>,
    pub due_at: Option<ReminderDueAt>,
}

