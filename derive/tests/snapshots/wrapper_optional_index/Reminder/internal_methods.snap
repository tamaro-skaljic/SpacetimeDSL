// get_by_primary_key
impl ReminderTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `reminder` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        id: impl Into<ReminderId> + Clone,
    ) -> Result<Reminder, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_reminder_by_id(id)
    }
}
