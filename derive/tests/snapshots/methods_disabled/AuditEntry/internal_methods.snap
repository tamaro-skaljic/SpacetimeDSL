// get_by_primary_key
impl AuditEntryTable {
    #[allow(clippy::needless_lifetimes, clippy::too_many_arguments)]
    ///Look a row of the `audit_entry` table up by its primary key, for the tables whose foreign keys reference it.
    pub fn get_by_primary_key<'a, T: crate::spacetimedsl::ReadContext>(
        dsl: &crate::spacetimedsl::ReadOnlyDSL<'_, T>,
        id: impl Into<AuditEntryId> + Clone,
    ) -> Result<AuditEntry, crate::spacetimedsl::error::SpacetimeDSLError> {
        dsl.get_audit_entry_by_id(id)
    }
}
